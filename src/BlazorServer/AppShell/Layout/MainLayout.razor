@using BlazorServer.Composition.UI;
@inherits LayoutComponentBase
@inject UiRegistry Ui
@inject LoginDisplayRecord LoginDisplay
@inject IComponentHtmlRenderer IComponentHtmlRenderer


<div style="height: 100dvh;">
    <style>
        .app-bar{
            position: fixed;
            top: 0;
            left: 0;
            width: 100%; 
            z-index: 1000;
        }
    </style>


    <MudToolBar Dense="true" Gutters="false" Class="px-4 mud-elevation-4 app-bar" Style="z-index: 10000; background-color: var(--mud-palette-drawer-background)">
        <a href="@AppShellRoutes.Home"><MudText Typo="Typo.h5" Style="color: var(--mud-palette-primary)"><b>Kalkylinsiktsportalen</b></MudText></a>
        <div class="py-2 px-3" style="height: 100%;">
            <MudDivider Vertical="true" />
        </div>
                
        <div class="d-flex gap-1">
            @foreach (var item in Ui.TopNavigation)
            {
                if (item.Policy is not null)
                {
                    <AuthorizeView Policy="@item.Policy">
                        <Authorized>
                            <NavMenu FeatureRoute="@item.Href" Match="@item.Match" MenuTitle="@item.Text" />
                        </Authorized>
                    </AuthorizeView>
                }
                else
                {
                    <NavMenu FeatureRoute="@item.Href" Match="@item.Match" MenuTitle="@item.Text" />
                }
            }
        </div>

        <MudSpacer />

        @IComponentHtmlRenderer.Render(LoginDisplay.Type ?? throw new Exception("Login display component not found"))

    </MudToolBar>

    <div style="padding-top: 48px; height: 100%; background: var(--mud-palette-background-gray)">
        @Body
    </div>
</div>
