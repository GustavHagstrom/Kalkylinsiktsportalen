<AuthorizeView Context="authenticationState">
    <Authorized>
        <UserAvatar Name="@CurrentUser(authenticationState.User)?.DisplayName" OnClick="() => ShowLogoutPopover = !ShowLogoutPopover" />

        <MudPopover Open="ShowLogoutPopover" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudText Typo="Typo.subtitle2" Style="color: var(--mud-palette-text-primary);">@CurrentUser(authenticationState.User)?.DisplayName</MudText>
            <DarkmodeSwitch  ThemeManagerBackup="ThemeProvider" />
            <MudButton OnClick="Logout" Class="px-4 mr-n2" Style="height: 100%;" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Sharp.Logout">@Localizer["Logga ut"]</MudButton>
        </MudPopover>

        <MudOverlay Visible="ShowLogoutPopover" LockScroll="true" OnClick="() => ShowLogoutPopover = false" />
    </Authorized>

    <NotAuthorized>
        <MudButton Style="height: 100%" OnClick="Login">
            @Localizer["Logga in"]
        </MudButton>
    </NotAuthorized>
</AuthorizeView>

@inject IAuthenticationActions AuthenticationActions
@inject IStringLocalizer<LoginDisplay> Localizer

@code {
    bool ShowLogoutPopover = false;
    [CascadingParameter] CascadingThemeManager? ThemeProvider { get; set; }

    void Logout() => AuthenticationActions.Logout();
    void Login() => AuthenticationActions.Login();

    static CurrentUser? CurrentUser(System.Security.Claims.ClaimsPrincipal principal) => principal.ToCurrentUser();
}
