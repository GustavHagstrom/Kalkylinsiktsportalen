<AuthorizeView>
    <Authorized>
        <UserAvatar Name="@user?.DisplayName" AvatarBase64="@user?.Avatar" OnClick="() => ShowLogoutPopover = !ShowLogoutPopover" />

        <MudPopover Open="ShowLogoutPopover" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudText Typo="Typo.subtitle2" Style="color: var(--mud-palette-text-primary);">@user?.DisplayName</MudText>
            <DarkmodeSwitch  ThemeManagerBackup="ThemeProvider" />
            <MudButton OnClick="LogoutAsync" Class="px-4 mr-n2" Style="height: 100%;" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Sharp.Logout">@Localizer["Logga ut"]</MudButton>
        </MudPopover>

        <MudOverlay Visible="ShowLogoutPopover" LockScroll="true" OnClick="() => ShowLogoutPopover = false" />
    </Authorized>

    <NotAuthorized>
        <MudButton Style="height: 100%" OnClick="Login">
            @Localizer["Logga in"]
        </MudButton>
    </NotAuthorized>
</AuthorizeView>

@inject IAuthService AuthService
@inject IStringLocalizer<LoginDisplay> Localizer

@code {
    bool ShowLogoutPopover = false;
    CurrentUser? user => AuthService.CurrentUser;
    [CascadingParameter] CascadingThemeManager? ThemeProvider { get; set; }

    Task LogoutAsync() => AuthService.LogoutAsync();
    Task Login() => AuthService.LoginAsync();

    protected override async Task OnInitializedAsync()
    {
        await AuthService.RefreshAsync();
    }
}
