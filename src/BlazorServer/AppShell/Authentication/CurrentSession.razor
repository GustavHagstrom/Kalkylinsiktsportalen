<AuthorizeView Context="authenticationState">
    <Authorized>
        @if (CurrentUserSession.CurrentUser is not null)
        {
            <MudText Typo="Typo.h6">@CurrentUserSession.CurrentUser.DisplayName</MudText>
            <MudText Typo="Typo.subtitle2" Class="mb-0">@CurrentUserSession.CurrentUser.Email</MudText>
            @if (authenticationState.User.Claims.Any())
            {
                <ul>
                    @foreach (var claim in authenticationState.User.Claims)
                    {
                        <li>@claim.Type: @claim.Value</li>
                    }
                </ul>
            }
        }
    </Authorized>
    <NotAuthorized>
        <h3>No session</h3>
    </NotAuthorized>
</AuthorizeView>

@inject ICurrentUserContext CurrentUserSession
