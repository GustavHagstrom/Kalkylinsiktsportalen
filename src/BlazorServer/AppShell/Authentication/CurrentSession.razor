<AuthorizeView Context="authenticationState">
    <Authorized>
        @if (CurrentUser(authenticationState.User) is { } currentUser)
        {
            <MudText Typo="Typo.h6">@currentUser.DisplayName</MudText>
            <MudText Typo="Typo.subtitle2" Class="mb-0">@currentUser.Email</MudText>
            @if (authenticationState.User.Claims.Any())
            {
                <ul>
                    @foreach (var claim in authenticationState.User.Claims)
                    {
                        <li>@claim.Type: @claim.Value</li>
                    }
                </ul>
            }
        }
    </Authorized>
    <NotAuthorized>
        <h3>No session</h3>
    </NotAuthorized>
</AuthorizeView>

@code {
    static CurrentUser? CurrentUser(System.Security.Claims.ClaimsPrincipal principal) => principal.ToCurrentUser();
}
