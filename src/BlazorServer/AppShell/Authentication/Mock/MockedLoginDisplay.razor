@using BlazorServer.AppShell.Authentication

<AuthorizeView Context="authenticationState">
    <Authorized>
        <UserAvatar Name="@CurrentUser(authenticationState.User)?.DisplayName" OnClick="() => ShowLogoutPopover = !ShowLogoutPopover" />

        <MudPopover Open="ShowLogoutPopover" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudText Typo="Typo.subtitle2" Style="color: var(--mud-palette-text-primary);">@CurrentUser(authenticationState.User)?.DisplayName</MudText>
            <DarkmodeSwitch ThemeManagerBackup="ThemeProvider" />
            <MudButton OnClick="Logout" Class="px-4 mr-n2" Style="height: 100%;" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Sharp.Logout">@Localizer["Logga ut"]</MudButton>
        </MudPopover>

        <MudOverlay Visible="ShowLogoutPopover" LockScroll="true" OnClick="() => ShowLogoutPopover = false" />
    </Authorized>

    <NotAuthorized>
        <MudButton Style="height: 100%" OnClick="() => ShowLoginPopover = !ShowLoginPopover">
            @Localizer["Logga in"]
        </MudButton>

        <MudPopover Open="ShowLoginPopover" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudStack Spacing="2">
                @foreach (var user in MockDefaults.Users)
                {
                    <MudButton OnClick="() => Login(user)">@LoginText(user)</MudButton>
                }
            </MudStack>
        </MudPopover>

        <MudOverlay Visible="ShowLoginPopover" LockScroll="true" OnClick="() => ShowLoginPopover = false" />
    </NotAuthorized>
</AuthorizeView>

@inject MockCurrentUserSwitcher MockCurrentUserSwitcher
@inject MockAuthDefaults MockDefaults
@inject IStringLocalizer<MockedLoginDisplay> Localizer

@code {
    [CascadingParameter] CascadingThemeManager? ThemeProvider { get; set; }
    bool ShowLogoutPopover = false;
    bool ShowLoginPopover = false;

    string LoginText(CurrentUser user) => $"{Localizer["Logga in med"]} : {user.DisplayName}";

    void Logout() => MockCurrentUserSwitcher.Logout();

    void Login(CurrentUser user)
    {
        MockCurrentUserSwitcher.Login(user);
        ShowLoginPopover = false;
        ShowLogoutPopover = false;
    }

    static CurrentUser? CurrentUser(System.Security.Claims.ClaimsPrincipal principal) => principal.ToCurrentUser();
}
