@using BlazorServer.AppShell.Settings
<MudThemeProvider Theme="CustomThemes.PlatformStandard" IsDarkMode="IsDarkMode" DefaultScrollbar="false" />
<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

@inject IAuthService authService
@inject IDarkmodeStore DarkmodeStore

@code{
    [Parameter] public RenderFragment? ChildContent { get; set; }

    public bool IsDarkMode { get; private set; } = false;

    public async Task SetDarkModeAsync(bool isDarkMode)
    {
        IsDarkMode = isDarkMode;
        await authService.RefreshAsync();
        
        if (authService.CurrentUser is not null)
        {
            await DarkmodeStore.SetDarkmodeAsync(authService.CurrentUser.UserId.Value, IsDarkMode);
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await authService.RefreshAsync();

        if (authService.CurrentUser is not null)
        {
            IsDarkMode = await DarkmodeStore.IsDarkmodeAsync(authService.CurrentUser.UserId.Value);
        }
    }
}
