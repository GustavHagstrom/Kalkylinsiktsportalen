@using BlazorServer.AppShell.Settings
<MudThemeProvider Theme="CustomThemes.PlatformStandard" IsDarkMode="IsDarkMode" DefaultScrollbar="false" />
<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

@inject ICurrentUserContext CurrentUserContext
@inject IDarkmodeStore DarkmodeStore

@code{
    [Parameter] public RenderFragment? ChildContent { get; set; }

    public bool IsDarkMode { get; private set; } = false;

    public async Task SetDarkModeAsync(bool isDarkMode)
    {
        IsDarkMode = isDarkMode;
        
        var currentUser = await CurrentUserContext.GetCurrentUserAsync();
        if (currentUser is not null)
        {
            await DarkmodeStore.SetDarkmodeAsync(currentUser.UserId.Value, IsDarkMode);
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await CurrentUserContext.GetCurrentUserAsync();
        if (currentUser is not null)
        {
            IsDarkMode = await DarkmodeStore.IsDarkmodeAsync(currentUser.UserId.Value);
        }
    }
}
