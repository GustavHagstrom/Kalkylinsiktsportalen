@using BlazorServer.AppShell.Composition
@using BlazorServer.Shared.Stores
<MudThemeProvider Theme="CustomThemes.PlatformStandard" IsDarkMode="IsDarkMode" DefaultScrollbar="false" />
<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

@inject ICurrentUserSession CurrentUserSession
@inject IDarkmodeStore DarkmodeStore

@code{
    [Parameter] public RenderFragment? ChildContent { get; set; }

    public bool IsDarkMode { get; private set; } = false;

    public async Task SetDarkModeAsync(bool isDarkMode)
    {
        IsDarkMode = isDarkMode;
        await CurrentUserSession.RefreshAsync();
        
        if (CurrentUserSession.IsAuthenticated && CurrentUserSession.CurrentUser is not null)
        {
            await DarkmodeStore.SetDarkmodeAsync(CurrentUserSession.CurrentUser.UserId, IsDarkMode);
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await CurrentUserSession.RefreshAsync();

        if (CurrentUserSession.IsAuthenticated && CurrentUserSession.CurrentUser is not null)
        {
            IsDarkMode = await DarkmodeStore.IsDarkmodeAsync(CurrentUserSession.CurrentUser.UserId);
        }
    }
}
