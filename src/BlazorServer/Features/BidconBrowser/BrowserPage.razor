@page "/BidconBrowser"
@using BlazorServer.Shared.DTOs.Bidcon
@inject IStringLocalizer<BrowserPage> Localizer
<MudTabs Style="height: 100%">
    <MudTabPanel Text="@Localizer["Sök"]">
        @* <EstimationList Estimations="@Estimations" Height="100%" SelectionChanged="StateHasChanged"/>  *@
    </MudTabPanel>
    <MudTabPanel Text="@Localizer["Valda"]" BadgeColor="Color.Info" BadgeData="Estimations.Where(x => x.IsSelected).Count()">
        @* <EstimationList Estimations="@Estimations.Where(x => x.IsSelected)" Height="100%" SelectionChanged="StateHasChanged" /> *@
    </MudTabPanel>
</MudTabs>

@inject BidconApiAccess BidconAccess
@inject IAuthService AuthService
@code {
    List<EstimationInfo> Estimations { get; set; } = [];
    bool IsLoading { get; set; } = true;
    protected override Task OnInitializedAsync()
    {
        return LoadData();
    }
    async Task LoadData()
    {
        SetIsLoading(true);
        if (AuthService.UserEmail is null || AuthService.OrganizationId is null) return;
        var estimations = await BidconAccess.GetAllEstimationsFlat(AuthService.UserEmail, AuthService.OrganizationId);
        Estimations = estimations.Select(e => DtoToModel(e)).ToList();
        SetIsLoading(false);
    }
    void SetIsLoading(bool isLoading)
    {
        IsLoading = isLoading;
        StateHasChanged();
    }
    EstimationInfo DtoToModel(EstimationDto dto)
    {
        var name = string.IsNullOrWhiteSpace(dto.Description) ? dto.Name : $"{dto.Name} - {dto.Description}";
        return new EstimationInfo(name, dto.Id.ToString(), false);
    }
}
