@page "/BidconBrowser"
@using BlazorServer.Shared.DTOs.Bidcon
@inject IStringLocalizer<BrowserPage> Localizer
<MudOverlay Visible="IsLoading" DarkBackground="true" LockScroll="true">
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
</MudOverlay>

<PageSetupWithNavigation>
    <NavigationContent>
        <MudStack Spacing="0" Class="">
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LoadData" StartIcon="@Icons.Material.Sharp.Refresh">@Localizer["Uppdatera"]</MudButton>
            <MudButton Variant="@GetTabVariant(1)" Color="Color.Primary" OnClick="@(() => ActiveTab = 1)">@Localizer["Sök"]</MudButton>
            <MudButton Variant="GetTabVariant(2)" Color="Color.Primary" OnClick="@(() => ActiveTab = 2)">@($"{Localizer["Valda"]} ({SelectedEstimations.Count})")</MudButton>
        </MudStack>
    </NavigationContent>
    <ChildContent>
        @if(ActiveTab == 1)
        {
            <EstimationList Estimations="@Estimations" Height="100%" SelectionChanged="UpdateSelectedEstimations"/> 
        }
        else if (ActiveTab == 2)
        {
            <EstimationList Estimations="@SelectedEstimations" Height="100%" SelectionChanged="UpdateSelectedEstimations" />
        }
        else
        {
            <MudText>@Localizer["Välj en flik"]</MudText>
        }
    </ChildContent>
</PageSetupWithNavigation>


@inject BidconApiAccess BidconAccess
@inject IAuthService AuthService
@code {
    List<EstimationInfo> Estimations { get; set; } = [];
    List<EstimationInfo> SelectedEstimations { get; set; } = [];
    int ActiveTab { get; set; } = 1;
    bool IsLoading { get; set; } = true;


    Variant GetTabVariant(int tabIndex) => ActiveTab == tabIndex ? Variant.Filled : Variant.Outlined;

    protected override Task OnInitializedAsync()
    {
        return LoadData();
    }
    async Task LoadData()
    {
        SetIsLoading(true);
        if (AuthService.UserEmail is null || AuthService.OrganizationId is null) return;
        var estimations = await BidconAccess.GetAllEstimationsFlat(AuthService.UserEmail, AuthService.OrganizationId);
        Estimations = estimations.Select(e => DtoToModel(e)).OrderBy(x => x.Name).ToList();
        SetIsLoading(false);
    }
    void SetIsLoading(bool isLoading)
    {
        IsLoading = isLoading;
        StateHasChanged();
    }
    EstimationInfo DtoToModel(EstimationDto dto)
    {
        var name = string.IsNullOrWhiteSpace(dto.Description) ? dto.Name : $"{dto.Name} - {dto.Description}";
        return new EstimationInfo(name, dto.Id.ToString(), false);
    }
    void UpdateSelectedEstimations()
    {
        SelectedEstimations = Estimations.Where(x => x.IsSelected).ToList();
        StateHasChanged();

    }
}
