@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject IStringLocalizer<EstimationList> Localizer

<div style="@($"height: {Height}")">
    <div>
        <div class="d-flex" style="padding: 2px 2px 0px 2px">
            <MudCheckBox T="bool" Value="@Estimations.All(x => x.IsSelected)" ValueChanged="ToggleSelecedOnAllFilterd" Dense="true" />
            <input placeholder="Sökfilter" class="pa-2 flex-grow-1" style="outline: none; background-color: var(--mud-palette-background); color: var(--mud-palette-text-primary)" @bind="Filter" @bind:event="oninput" />
        </div>
        <MudDivider Light="true"/>
    </div>
    <div style="@($"overflow-y: scroll; position: relative; height: calc(100% - 37px)")">
    
 
        <table class="striped" style="width: 100%;">
            <tbody>
                <Virtualize Items="@GetFilteredEstimations()">
                    <tr class="d-flex">
                        <td class="d-flex flex-grow-1">
                            <MudCheckBox T="bool" Value="context.IsSelected" ValueChanged="x => SetIsSelected(context, x)" Dense="true"/>
                            <MudIcon Icon="@Icons.Material.Sharp.Article"  Style="color: var(--mud-palette-warning-lighten)" Class="align-self-center ml-0" />
                            <MudText Class="align-self-center ml-2">@context.Name</MudText>
                        </td>
                    </tr>
                </Virtualize>
            </tbody>
        </table>
        
    </div>
    
</div>


@code{
    [Parameter, EditorRequired] public List<EstimationInfo> Estimations { get; set; } = [];
    [Parameter] public string Height { get; set; } = string.Empty;
    [Parameter] public EventCallback SelectionChanged { get; set; }


    string Filter { get; set; } = string.Empty;

    List<EstimationInfo> GetFilteredEstimations()
    {
        var words = Filter.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return Estimations.Where(e => words.All(w => e.Name.Contains(w, StringComparison.OrdinalIgnoreCase))).ToList();
    }

    Task SetIsSelected(EstimationInfo estimation, bool value)
    {
        estimation.IsSelected = value;
        return SelectionChanged.InvokeAsync();
    }
    Task ToggleSelecedOnAllFilterd()
    {
        foreach (var estimation in GetFilteredEstimations())
        {
            estimation.IsSelected = !estimation.IsSelected;
        }
        return SelectionChanged.InvokeAsync();
    }
}