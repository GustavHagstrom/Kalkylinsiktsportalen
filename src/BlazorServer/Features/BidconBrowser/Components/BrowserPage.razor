@page "/BidconBrowser"
@using BlazorServer.Shared.DTOs.Bidcon
@inject IStringLocalizer<BrowserPage> Localizer
<MudOverlay Visible="IsLoading" DarkBackground="true" LockScroll="true">
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
</MudOverlay>

<ToolbarPage>
    <LeftToolbarContent>

    </LeftToolbarContent>
    <CenterToolbarContent>
        <MudStack Spacing="2" Row="true">
            <MudIconButton Size="Size.Medium" Color="Color.Primary" OnClick="LoadData" Icon="@Icons.Material.Sharp.Refresh" Class="pa-1" />@* @Localizer["Uppdatera"]</MudIconButton> *@
            <MudButton Size="Size.Small" Variant="@GetTabVariant(1)" Color="Color.Primary" OnClick="@(() => ActiveTab = 1)">@Localizer["Sök"]</MudButton>
            <MudButton Size="Size.Small" Variant="GetTabVariant(2)" Color="Color.Primary" OnClick="@(() => ActiveTab = 2)">@($"{Localizer["Valda"]} ({EstimationListState.SelectedEstimations.Count})")</MudButton>

        </MudStack>
    </CenterToolbarContent>
    <ChildContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4 full-height">
            <MudPaper Class="full-height">
                @if (ActiveTab == 1)
                {
                    <EstimationList Estimations="@EstimationListState.Estimations" Height="100%" SelectionChanged="UpdateSelectedEstimations" />
                }
                else if (ActiveTab == 2)
                {
                    <EstimationList Estimations="@EstimationListState.SelectedEstimations" Height="100%" SelectionChanged="UpdateSelectedEstimations" />
                }
                else
                {
                    <MudText>@Localizer["Välj en flik"]</MudText>
                }
            </MudPaper>
            
        </MudContainer>
        
    </ChildContent>
</ToolbarPage>


@inject BidconApiAccess BidconAccess
@inject IAuthService AuthService
@inject EstimationListState EstimationListState

@code {
    int ActiveTab { get; set; } = 1;
    bool IsLoading { get; set; } = false;


    Variant GetTabVariant(int tabIndex) => ActiveTab == tabIndex ? Variant.Filled : Variant.Outlined;

    protected override Task OnInitializedAsync()
    {
        if (EstimationListState.HasLoaded) return Task.CompletedTask;
        return LoadData();
    }
    async Task LoadData()
    {
        SetIsLoading(true);
        if (AuthService.UserEmail is null || AuthService.OrganizationId is null) return;
        var estimations = await BidconAccess.GetAllEstimationsFlat(AuthService.UserEmail, AuthService.OrganizationId);
        EstimationListState.Estimations = estimations.Select(e => DtoToModel(e)).OrderBy(x => x.Name).ToList();
        EstimationListState.HasLoaded = true;
        SetIsLoading(false);
    }
    void SetIsLoading(bool isLoading)
    {
        IsLoading = isLoading;
        StateHasChanged();
    }
    EstimationInfo DtoToModel(EstimationDto dto)
    {
        var name = string.IsNullOrWhiteSpace(dto.Description) ? dto.Name : $"{dto.Name} - {dto.Description}";
        return new EstimationInfo(name, dto.Id.ToString(), false);
    }
    void UpdateSelectedEstimations()
    {
        EstimationListState.SelectedEstimations = EstimationListState.Estimations.Where(x => x.IsSelected).ToList();
        StateHasChanged();

    }
}
