<MudSimpleTable Dense="true" Bordered="false">
    <tbody>
        @foreach (var claimInfo in AccessClaims.Claims)
        {
            <tr>
                <td class="pl-2">
                    <MudCheckBox T="bool" 
                                 Dense="true" 
                                 Value="@PickedAccessClaimValues.Any(x => x == claimInfo.Value)" 
                                 Label="@claimInfo.Description"
                                 ValueChanged="x => OnCheckChanged(claimInfo, x)" />
                </td>
            </tr>
            
        }
    </tbody>
</MudSimpleTable>

@inject AccessClaimRegistry AccessClaims

@code{
    /// <summary>
    /// Picked access claim values for role or user.
    /// </summary>
    [Parameter] public List<string> PickedAccessClaimValues { get; set; } = [];
    [Parameter] public EventCallback<PickChangedRecord<AccessClaimInfo>> PickChanged { get; set; }

    Task OnCheckChanged(AccessClaimInfo info, bool isChecked)
    {
        return PickChanged.InvokeAsync(new (info, isChecked));
    }

}