@page "/Settings/rights/UserEdit/{UserId}"
@layout SettingsLayout
@inject IStringLocalizer<EditUserAccessPage> Localizer

<SettingsPageBase>

    <SettingsSection Title="@Localizer["Användare"]">
        <UserAvatar User="User"/>
    </SettingsSection>

    <SettingsSection Title="@Localizer["Rättigheter"]" LoadDataAsync="LoadUserDataAsync">
        <MudOverlay DarkBackground="true" Visible="IsLoading" Absolute="true">
            <MudProgressCircular Size="Size.Large" Color="Color.Primary" Indeterminate="true" />
        </MudOverlay>
        <AccessClaimValuePicker PickedAccessClaimValues="UserAccess?.AccessClaimValues ?? []" PickChanged="UserAccessCheckBoxClick" />
    </SettingsSection>

    <SettingsSection Title="@Localizer["Roller"]">
        <RoleList Roles="PickedRoles" />
    </SettingsSection>
</SettingsPageBase>

@inject IAccessStore AccessStore
@inject IRoleService RoleService
@inject ClaimInfoCollection ClaimInfoCollection
@inject IUserService UserService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

@code{
    [Parameter] public string? UserId { get; set; }
    User? User { get; set; }
    UserAccess? UserAccess { get; set; }
    List<Role> AllRoles { get; set; } = [];
    List<Role> PickedRoles { get; set; } = [];

    bool IsLoading { get; set; } = false;

    async Task LoadUserDataAsync()
    {
        SetIsLoading(true);
        if (UserId is not null && AuthService.OrganizationId is not null)
        {
            UserAccess = await AccessStore.GetUserAccessAsync(UserId, AuthService.OrganizationId);
            User = await UserService.GetUserAsync(UserId);
            AllRoles = await RoleService.GetRolesAsync(AuthService.OrganizationId);
            var pickedRoles = await RoleService.GetRolesForUserAsync(UserId, AuthService.OrganizationId);
            PickedRoles = AllRoles.Where(r => pickedRoles.Any(pr => pr.Id == r.Id)).ToList();
        }
        SetIsLoading(false);
    }
    void SetIsLoading(bool isLoading)
    {
        IsLoading = isLoading;
        StateHasChanged();
    }
