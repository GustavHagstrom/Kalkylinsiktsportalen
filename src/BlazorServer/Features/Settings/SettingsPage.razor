@page "/settings"
@layout SettingsLayout
@inject RenderService RenderService

@inject IStringLocalizer<SettingsPage> Localizer

@inject UiCompositionRegistry UiComposition


<SettingsPageBase>
    @foreach (var component in UiComposition.SettingsSections)
    {
        @RenderService.Render(component.ComponentType);
    }
</SettingsPageBase>
