@page "/settings/api"

@layout SettingsLayout
@inject IStringLocalizer<SettingsPage> Localizer

<SettingsPageBase Title="@Localizer["Bidcon API"]">
    <SettingsSection LoadDataAsync="LoadDataAsync">
        <KipTextField TValue="string" Label="@Localizer["Sparad nyckel"]" Value="@currentKey" />
        <KipTextField TValue="string" Label="@Localizer["Sparad hemlighet"]" Value="@currentSecret" />
        <KipTextField TValue="string" Label="@Localizer["Ny nyckel"]" Value="@newKey" ValueChanged="@UpdateKeyAsync"/>
        <KipTextField TValue="string" Label="@Localizer["Ny hemlighet"]" Value="@newSecret" ValueChanged="@UpdateSecretAsync"/>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@Localizer["Spara"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RemoveAsync" Disabled="@(!isConfigured)">@Localizer["Ta bort"]</MudButton>
        </MudStack>
        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <MudText Color="@statusColor">@statusMessage</MudText>
        }
    </SettingsSection>
</SettingsPageBase>

@inject BlazorServer.Modules.Bidcon.Features.GetBidconCredentials.GetBidconCredentialsQueryHandler GetCredentialsHandler
@inject BlazorServer.Modules.Bidcon.Features.UpsertBidconCredentials.UpsertBidconCredentialsCommandHandler UpsertCredentialsHandler
@inject BlazorServer.Modules.Bidcon.Features.RemoveBidconCredentials.RemoveBidconCredentialsCommandHandler RemoveCredentialsHandler
@inject IAuthService AuthService

@code {
    string currentKey { get; set; } = string.Empty;
    string currentSecret { get; set; } = string.Empty;
    string newKey { get; set; } = string.Empty;
    string newSecret { get; set; } = string.Empty;
    string statusMessage { get; set; } = string.Empty;
    Color statusColor { get; set; } = Color.Default;
    bool isConfigured { get; set; }

    Task UpdateKeyAsync(string value)
    {
        newKey = value;
        return Task.CompletedTask;
    }

    Task UpdateSecretAsync(string value)
    {
        newSecret = value;
        return Task.CompletedTask;
    }

    async Task LoadDataAsync()
    {
        if (AuthService.OrganizationId is null) return;

        var result = await GetCredentialsHandler.HandleAsync(
            new BlazorServer.Modules.Bidcon.Features.GetBidconCredentials.GetBidconCredentialsQuery(
                new BlazorServer.Shared.Kernel.Identity.OrganizationId(Guid.Parse(AuthService.OrganizationId))),
            CancellationToken.None);

        if (!result.IsSuccess || result.Value is null) return;

        currentKey = result.Value.ApiKey;
        currentSecret = result.Value.ApiSecret;
        isConfigured = result.Value.IsConfigured;
    }

    async Task SaveAsync()
    {
        if (AuthService.OrganizationId is null) return;

        var organizationId = new BlazorServer.Shared.Kernel.Identity.OrganizationId(Guid.Parse(AuthService.OrganizationId));
        var result = await UpsertCredentialsHandler.HandleAsync(
            new BlazorServer.Modules.Bidcon.Features.UpsertBidconCredentials.UpsertBidconCredentialsCommand(
                organizationId,
                newKey,
                newSecret),
            CancellationToken.None);

        if (!result.IsSuccess)
        {
            statusColor = Color.Error;
            statusMessage = string.Join(" ", result.Errors.Select(error => error.Message));
            return;
        }

        newKey = string.Empty;
        newSecret = string.Empty;
        statusColor = Color.Success;
        statusMessage = Localizer["Sparat."];
        await LoadDataAsync();
    }

    async Task RemoveAsync()
    {
        if (AuthService.OrganizationId is null) return;

        var organizationId = new BlazorServer.Shared.Kernel.Identity.OrganizationId(Guid.Parse(AuthService.OrganizationId));
        var result = await RemoveCredentialsHandler.HandleAsync(
            new BlazorServer.Modules.Bidcon.Features.RemoveBidconCredentials.RemoveBidconCredentialsCommand(organizationId),
            CancellationToken.None);

        if (!result.IsSuccess)
        {
            statusColor = Color.Error;
            statusMessage = string.Join(" ", result.Errors.Select(error => error.Message));
            return;
        }

        currentKey = string.Empty;
        currentSecret = string.Empty;
        newKey = string.Empty;
        newSecret = string.Empty;
        isConfigured = false;
        statusColor = Color.Success;
        statusMessage = Localizer["Borttaget."];
    }
}
