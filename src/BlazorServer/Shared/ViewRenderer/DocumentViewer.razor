<script src="@Assets["Pageination/engine.js"]"></script>
<HeadContent>
    <link href="@Assets["Pageination/styles.css"]" rel="stylesheet" />
</HeadContent>

<div class="full-height">
    <MudButton OnClick="Print">Skriv ut</MudButton>
    <div id="print-root" class="d-flex flex-column gap-3" style="@($"width: {PageSizes[PageFormat].widthMm}mm;")">
        <div class="footer-block" style="background-color: yellow; height: 50mm;"> jag är en footer 1</div>
        <div class="header-block" style="background-color: pink; height: 50mm;"> jag är en header 1</div>
        @for (int i = 0; i < 25; i++)
        {
            <div class="body-block" data-id="@i" style="background-color: deepskyblue; height: 30mm;"> jag är body @i</div>
        }
        @* <A4Page />
        <A4Page /> *@
    </div>
</div>



@inject IJSRuntime JS
@code {

    PageSizeFormat PageFormat { get; set; } = PageSizeFormat.A4;
    enum PageSizeFormat
    {
        A4,
        A3,
    }
    Dictionary<PageSizeFormat, (double widthMm, double heightMm)> PageSizes = new()
    {
        { PageSizeFormat.A4, (210, 297) },
        { PageSizeFormat.A3, (297, 420) },
    };


    async Task Print()
    {
        await JS.InvokeVoidAsync("lol");
    }
    bool IsPaginated { get; set; } = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsPaginated)
        {
            await Paginate();
        }
    }

    async Task Paginate()
    {
        IsPaginated = true;
        var result = await JS.InvokeAsync<Dictionary<int, string[]>>("pageinate");
        StateHasChanged();

    }
    
}
