<script src="@Assets["Pageination/engine.js"]"></script>
<HeadContent>
    <link href="@Assets["Pageination/styles.css"]" rel="stylesheet" />
</HeadContent>


<MudButton OnClick="Print">Skriv ut</MudButton>
<div id="print-wrapper">
    <div id="print-root" class="d-flex flex-column gap-4" style="@($"width: {PageSizes[PageFormat].widthMm}mm;")">
        @if (!IsPaginated)
        {
            BodyComponentId = 0;
            IdComponentMap.Clear();
            foreach (var component in headerComponents)
            {
                <div class="header-block">
                    @RenderService.Render(component.ComponentType, component.Parameters)
                </div>
            }
            foreach (var component in bodyComponents)
            {
                BodyComponentId += 1;
                IdComponentMap.Add(BodyComponentId, component);
                <div class="body-block" data-id="@BodyComponentId">
                    @RenderService.Render(component.ComponentType, component.Parameters)
                </div>
            }
            foreach (var component in footerComponents)
            {
                <div class="footer-block">
                    @RenderService.Render(component.ComponentType, component.Parameters)
                </div>
            }
        }
        else
        {
            foreach (var page in PageMap.Keys.Order())
            {
                <A4Page>
                    <Header>
                        @foreach (var component in headerComponents)
                        {
                            @RenderService.Render(component.ComponentType, component.Parameters)
                        }
                    </Header>
                    <Body>
                        @foreach (var id in PageMap[page])
                        {
                            @RenderService.Render(IdComponentMap[int.Parse(id)].ComponentType, IdComponentMap[int.Parse(id)].Parameters)
                        }
                    </Body>
                    <Footer>
                        @foreach (var component in footerComponents)
                        {
                            @RenderService.Render(component.ComponentType, component.Parameters)
                        }
                    </Footer>
                </A4Page>

            }
        }
    </div>
</div>

   



@inject IJSRuntime JS
@inject RenderService RenderService
@code {

    int BodyComponentId = 1;

    /// <summary>
    /// key: Id value, value: list of components on that page
    /// </summary>
    Dictionary<int, (Type ComponentType, Dictionary<string, object> Parameters)> IdComponentMap = new();

    /// <summary>
    /// key: page number, value: array of component ids on that page
    /// </summary>
    Dictionary<int, string[]> PageMap = new();


    List<(Type ComponentType, Dictionary<string, object> Parameters)> bodyComponents =
    [
        //10 st components
        new (typeof(Demo), new Dictionary<string, object>() { { "Test", "Komponent 1" } }),
        new (typeof(Demo), new Dictionary<string, object>() { { "Test", "Komponent 2" } }),
        new (typeof(Demo), new Dictionary<string, object>() { { "Test", "Komponent 3" } }),
        new (typeof(Demo), new Dictionary<string, object>() { { "Test", "Komponent 4" } }),
        new (typeof(Demo2), new Dictionary<string, object>() { { "Test", "Komponent 5" } }),
        new (typeof(Demo2), new Dictionary<string, object>() { { "Test", "Komponent 6" } }),
        new (typeof(Demo), new Dictionary<string, object>() { { "Test", "Komponent 7" } }),
        new (typeof(Demo2), new Dictionary<string, object>() { { "Test", "Komponent 8" } }),
        new (typeof(Demo), new Dictionary<string, object>() { { "Test", "Komponent 9" } }),
        new (typeof(Demo2), new Dictionary<string, object>() { { "Test", "Komponent 10" } }),
    ];
    List<(Type ComponentType, Dictionary<string, object> Parameters)> headerComponents =
    [
        //2 headers
        new (typeof(Demo), new Dictionary<string, object>() { { "Test", "Header Komponent 1" } }),
        new (typeof(Demo2), new Dictionary<string, object>() { { "Test", "Header Komponent 2" } }),

    ];
    List<(Type ComponentType, Dictionary<string, object> Parameters)> footerComponents =
    [
        //2 footers
        new (typeof(Demo), new Dictionary<string, object>() { { "Test", "Footer Komponent 1" } }),
        new (typeof(Demo2), new Dictionary<string, object>() { { "Test", "Footer Komponent 2" } }),    
    ];

    PageSizeFormat PageFormat { get; set; } = PageSizeFormat.A4;
    enum PageSizeFormat
    {
        A4,
        A3,
    }
    Dictionary<PageSizeFormat, (double widthMm, double heightMm)> PageSizes = new()
    {
        { PageSizeFormat.A4, (210, 297) },
        { PageSizeFormat.A3, (297, 420) },
    };


    async Task Print()
    {
        await JS.InvokeVoidAsync("window.print");
    }
    bool IsPaginated { get; set; } = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsPaginated)
        {
            await Paginate();
        }
    }

    async Task Paginate()
    {
        IsPaginated = true;
        PageMap = await JS.InvokeAsync<Dictionary<int, string[]>>("pageinate");
        StateHasChanged();

    }
    
}
