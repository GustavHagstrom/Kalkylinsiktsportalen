@inject IJSRuntime JS
@code {
    async Task Print()
    {
        await JS.InvokeVoidAsync("lol");
    }
    bool IsPaginated { get; set; } = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsPaginated)
        {
            await Paginate();
        }
    }
    async Task Paginate()
    {
        await JS.InvokeVoidAsync("pageinate");
        IsPaginated = true;
        StateHasChanged();
    }
}
