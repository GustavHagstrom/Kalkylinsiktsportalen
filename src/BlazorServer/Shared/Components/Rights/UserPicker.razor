@inject IStringLocalizer<UserPicker> Localizer

@if (EnablePicking)
{
    <MudSwitch T="bool" @bind-Value="ShowOnlyPicked" Label="@Localizer["Visa endast valda"]" Color="Color.Primary" />
}

<MudTextField T="string" Variant="Variant.Outlined" @bind-Value="Filter" Label="@Localizer["Sök"]" Margin="Margin.Dense" Immediate="true" />
<MudSimpleTable Hover="false" Dense="true" Bordered="false">
    <tbody>
        @foreach (var user in UsersIterator)
        {
            <tr>
                @if (EnablePicking)
                {
                    <td class="pl-2" >
                    <MudCheckBox T="bool"
                                 Dense="true"
                                 Value="@PickedUserIds.Any(x => x == user.Id)"
                                 ValueChanged="x => OnPickChanged(user, x)" />
                    </td>
                }
                
                <td class="pl-2" style="width: 100%;">
                    <UserAvatar Size="Size.Small" User="user"/>
                </td>
                @if(ExtraTdContent is not null)
                {
                    <td class="pl-2">
                        @ExtraTdContent.Invoke(user)
                    </td>
                }
            </tr>
        }
    </tbody>
</MudSimpleTable>


@code {
    [Parameter] public bool EnablePicking { get; set; } = true;
    [Parameter] public List<string> PickedUserIds { get; set; } = new List<string>();
    [Parameter] public List<User> AllUsers { get; set; } = new List<User>();
    [Parameter] public EventCallback<PickChangedRecord<User>> PickChanged { get; set; }
    [Parameter] public RenderFragment<User>? ExtraTdContent { get; set; }

    bool ShowOnlyPicked { get; set; } = false;
    string Filter { get; set; } = string.Empty;
    IEnumerable<string> FilterWords => Filter.Split(' ', StringSplitOptions.RemoveEmptyEntries);

    IEnumerable<User> UsersIterator => AllUsers
        .Where(x => ShowOnlyPicked == true ? PickedUserIds.Contains(x.Id!) : true)
        .Where(user => FilterWords.All(word => user.Name is null ? false : user.Name.ToLower().Contains(word.ToLower())))
        .OrderBy(x => x.Name);

    async Task OnPickChanged(User user, bool value)
    {
        await PickChanged.InvokeAsync(new PickChangedRecord<User>(user, value));
        StateHasChanged();
    }
}