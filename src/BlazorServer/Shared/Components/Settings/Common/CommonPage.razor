@page "/settings"
@layout SettingsLayout
@inject RenderService RenderService

@inject IStringLocalizer<CommonPage> Localizer

@inject RenderCollection RenderCollection


<SettingsPageBase>
    <DarkModeSection />
    @foreach (var component in RenderCollection.GetSharedSettingComponents())
    {
        @RenderService.Render(component);
    }
</SettingsPageBase>
