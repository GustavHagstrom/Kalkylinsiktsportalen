<td class="@Class" style="@FormatBuilder.BuildCellStyle(DataCellDto.CellFormat)" @onclick="() => OnClick.InvokeAsync(DataCellDto)"> 
    <div style="@FormatBuilder.BuildTextStyle(DataCellDto.TextFormat)">
        @DataCellDto.Value
    </div>
</td>

@code {

    [Parameter, EditorRequired] public DataCellDto DataCellDto { get; set; }
    [Parameter] public bool EditMode { get; set; } = false;
    [Parameter] public bool IsSelected { get; set; } = false;
    [Parameter] public EventCallback<DataCellDto> OnClick { get; set; }

    string Class => EditMode ? (IsSelected ? "data-cell edit-mode selected" : "data-cell edit-mode") : "data-cell";
}
