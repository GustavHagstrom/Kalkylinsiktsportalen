<MudDialog>
    <DialogContent>
        @Info
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Success" OnClick="Submit">Ok</MudButton>
    </DialogActions>
</MudDialog>
@code {
    public const string InfoParameter = "Info";
    [CascadingParameter] public MudDialog? MudDialog { get; set; }
    [Parameter] public string Info { get; set; } = string.Empty;

    Task Submit() => MudDialog?.CloseAsync(DialogResult.Ok(true)) ?? Task.CompletedTask;
}