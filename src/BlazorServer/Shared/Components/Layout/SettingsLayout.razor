@using BlazorServer.Shared.Registration
@using MudBlazor.Services
@inherits LayoutComponentBase
@layout MainLayout

@inject IStringLocalizer<SettingsLayout> Localizer
@inject RenderCollection RenderCollection
@inject RenderService RenderService
<PageSetupWithNavigation >
    <NavigationContent>

        <SettingsNavLink Href="@SharedAppRoutes.Settings" Match="NavLinkMatch.All" Icon="@Icons.Material.Sharp.Settings" Text="@Localizer["Allmänt"]"/>
        @foreach (var component in RenderCollection.GetSettingNavigationComponents())
        {
            @RenderService.Render(component)
        }


    </NavigationContent>
    <ChildContent>
        @Body
    </ChildContent>
</PageSetupWithNavigation>
