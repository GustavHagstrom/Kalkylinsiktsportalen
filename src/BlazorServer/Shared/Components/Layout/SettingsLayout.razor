@using BlazorServer.Shared.Registration
@using MudBlazor.Services
@inherits LayoutComponentBase
@layout MainLayout

@inject IStringLocalizer<SettingsLayout> Localizer
@inject UiCompositionRegistry UiComposition
@inject RenderService RenderService
<PageSetupWithNavigation >
    <NavigationContent>

        <SettingsNavLink Href="@AppRoutes.Settings" Match="NavLinkMatch.All" Icon="@Icons.Material.Sharp.Settings" Text="@Localizer["Allmänt"]"/>
        @foreach (var item in UiComposition.SettingsNavigation)
        {
            <SettingsNavLink Href="@item.Href"
                             Match="@item.Match"
                             Icon="@item.Icon"
                             Text="@item.Text"
                             AuthPolicy="@item.Policy" />
        }


    </NavigationContent>
    <ChildContent>
        @Body
    </ChildContent>
</PageSetupWithNavigation>
