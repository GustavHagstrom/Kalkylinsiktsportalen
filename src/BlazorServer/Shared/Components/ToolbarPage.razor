<div class="container">
    <MudOverlay DarkBackground="true" Visible="IsLoading" Absolute="true">
        <MudProgressCircular Size="Size.Large" Color="Color.Primary" Indeterminate="true" />
    </MudOverlay>
    <div class="toolbar">
        <div>
            @LeftToolbarContent
        </div>
        <div>
            @CenterToolbarContent
        </div>
        <div>
            @RightToolbarContent
        </div>
    </div>
    <div class="content">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? LeftToolbarContent { get; set; }
    [Parameter] public RenderFragment? CenterToolbarContent { get; set; }
    [Parameter] public RenderFragment? RightToolbarContent { get; set; }
    [Parameter] public bool IsLoading { get; set; } = false;
}
