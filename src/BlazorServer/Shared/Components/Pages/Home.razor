@page "/"
@using BlazorServer.Shared.Services.Bidcon

<CurrentSession/>

<AuthorizeView>
    <Authorized>
        <button @onclick="GetAllEstimationsFlat">Get Estimations flat</button>
        <button @onclick="@(() => GetEstimationById("2db38e0e-aaa3-413e-80b6-e9a97d4c861e"))">Get estimation with ID: ....</button>
    </Authorized>
</AuthorizeView>

@inject BidconApiAccess BidconAccess
@inject IAuthService AuthService

@code{
    async Task GetAllEstimationsFlat()
    {
        if (AuthService.OrganizationId is null) return;
        var estimations = await BidconAccess.GetAllEstimationsFlat("gustav@rorvikshus.se", AuthService.OrganizationId);
    }
    async Task GetEstimationById(string estimationId)
    {
        if (AuthService.OrganizationId is null) return;
        var estimation = await BidconAccess.GetEstimationAsync(estimationId, AuthService.OrganizationId);
    }

}