@using BlazorServer.Modules.Reports.Domain.Views
@using BlazorServer.Modules.Reports.Public
<MudSimpleTable Hover="false" Dense="true" Bordered="false">
    <tbody>
        @foreach (var view in Views)
        {
            <tr>
                <td class="pl-2">
                    <MudText Typo="Typo.body2">@view.Name</MudText>
                </td>
                <td>
                    <MudText Typo="Typo.body2">@view.Description</MudText>
                </td>
                <td>
                    <div style="display: flex; justify-content: flex-end;">
                        <MudIconButton Icon="@Icons.Material.Sharp.Edit" Color="Color.Primary" Href="@ReportsRoutes.EditViewPage(view.Id)" Size="Size.Small" />
                    </div>
                </td>
            </tr>
        }
    </tbody>
</MudSimpleTable>



@code {
    [Parameter] public List<ViewDto> Views { get; set; } = new();
}
