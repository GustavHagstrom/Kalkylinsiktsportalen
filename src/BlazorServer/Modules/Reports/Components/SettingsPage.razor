@page "/Settings/views"
@using BlazorServer.Kernel.CQRS
@using BlazorServer.Modules.Reports.Features.CreateView
@using BlazorServer.Modules.Reports.Features.ListViews
@using BlazorServer.Modules.Reports.Domain.Views
@using BlazorServer.Modules.Reports.Public
@using BlazorServer.Modules.Reports.Components

<ToolbarPage IsLoading="isLoading">
    <LeftToolbarContent>
        <MudIconButton Icon="@Icons.Material.Sharp.Add" Color="Color.Primary"  OnClick="@NewView" Class="pa-1"/>
    </LeftToolbarContent>

    <CenterToolbarContent>
        
    </CenterToolbarContent>

    <ChildContent>
        <div class="d-flex full-height pa-4">
            <MudPaper Class="full-height" Style="overflow: auto; min-width: 300px;">
                <ViewList Views="Views" />
            </MudPaper>
            <MudSpacer />
        </div>
        
    </ChildContent>
</ToolbarPage>

@inject ICommandHandler<CreateViewCommand, CreateViewResult> CreateView
@inject IQueryHandler<ListViewsQuery, ListViewsResult> ListViews
@inject IDialogService DialogService
@inject IStringLocalizer<SettingsPage> Localizer
@inject ICurrentUserContext CurrentUserSession
@inject NavigationManager Navigation
@code {
    bool isLoading = false;
    List<View> Views = new();

    protected override Task OnInitializedAsync()
    {
        return LoadDataAsync();
    }

    async Task NewView()
    {
        var currentUser = await CurrentUserSession.GetCurrentUserAsync();
        if(currentUser?.OrganizationId is null) return;

        var parameters = new DialogParameters<StringInputDialog>()
        {
            { x => x.InputLabel, Localizer["Namn"] }
        };
        var dialog = await DialogService.ShowAsync<StringInputDialog>(Localizer["Ny vy"], parameters);
        var result = await dialog.Result;
        if (result != DialogResult.Cancel() && result?.Data is not null && result.Data is string name)
        {
            var createResult = await CreateView.HandleAsync(
                new CreateViewCommand(currentUser.OrganizationId, name),
                CancellationToken.None);

            if (createResult is ViewCreated created)
            {
                Navigation.NavigateTo(ReportsRoutes.EditViewPage(created.ViewId));
            }
        }
        
    }

    async Task LoadDataAsync()
    {
        var currentUser = await CurrentUserSession.GetCurrentUserAsync();
        if (currentUser?.OrganizationId is null) return;
        SetLoading(true);
        var result = await ListViews.HandleAsync(
            new ListViewsQuery(currentUser.OrganizationId),
            CancellationToken.None);

        Views = result is ViewsListed listed ? listed.Views.ToList() : [];
        SetLoading(false);
    }
    void SetLoading(bool loading)
    {
        isLoading = loading;
        StateHasChanged();
    }
}
