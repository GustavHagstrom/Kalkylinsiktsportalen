@inject IStringLocalizer<TextFormatEditor> Localizer



@if(Format is null)
{
    
}
else
{
    <div class="@baseRowClass">

        <div class="column">
            <div class="row">
                <IsActiveIconButton IsActive="Format!.VerticalAlign == BlazorServer.Modules.Reports.Domain.Views.Align.Start"
                                    Icon="@Icons.Material.Sharp.VerticalAlignTop"
                                    OnClick="() => Format.VerticalAlign = BlazorServer.Modules.Reports.Domain.Views.Align.Start"
                                    Class="border border-solid" 
                                    Enabled="@Enabled"/>
                <IsActiveIconButton IsActive="Format!.VerticalAlign == BlazorServer.Modules.Reports.Domain.Views.Align.Center"
                                    Icon="@Icons.Material.Sharp.VerticalAlignCenter"
                                    OnClick="() => Format.VerticalAlign = BlazorServer.Modules.Reports.Domain.Views.Align.Center"
                                    Class="border border-solid" 
                                    Enabled="@Enabled" />
                <IsActiveIconButton IsActive="Format!.VerticalAlign == BlazorServer.Modules.Reports.Domain.Views.Align.End"
                                    Icon="@Icons.Material.Sharp.VerticalAlignBottom"
                                    OnClick="() => Format.VerticalAlign = BlazorServer.Modules.Reports.Domain.Views.Align.End"
                                    Class="border border-solid" 
                                    Enabled="@Enabled" />

                <IsActiveIconButton IsActive="Format!.IsBold"
                                    Icon="@Icons.Material.Sharp.FormatBold" 
                                    OnClick="() => Format.IsBold = !Format.IsBold" 
                                    Class="border border-solid" 
                                    Enabled="@Enabled" />
                <IsActiveIconButton IsActive="Format!.IsItalic" 
                                    Icon="@Icons.Material.Sharp.FormatItalic" 
                                    OnClick="() => Format.IsItalic = !Format.IsItalic"
                                    Class="border border-solid" 
                                    Enabled="@Enabled" />





            </div>
            <div class="row">
                <IsActiveIconButton IsActive="Format!.HorizontalAlign == BlazorServer.Modules.Reports.Domain.Views.Align.Start"
                                    Icon="@Icons.Material.Sharp.AlignHorizontalLeft"
                                    OnClick="() => Format.HorizontalAlign = BlazorServer.Modules.Reports.Domain.Views.Align.Start"
                                    Class="border border-solid" 
                                    Enabled="@Enabled" />
                <IsActiveIconButton IsActive="Format!.HorizontalAlign == BlazorServer.Modules.Reports.Domain.Views.Align.Center"
                                    Icon="@Icons.Material.Sharp.AlignHorizontalCenter"
                                    OnClick="() => Format.HorizontalAlign = BlazorServer.Modules.Reports.Domain.Views.Align.Center"
                                    Class="border border-solid" 
                                    Enabled="@Enabled" />
                <IsActiveIconButton IsActive="Format!.HorizontalAlign == BlazorServer.Modules.Reports.Domain.Views.Align.End"
                                    Icon="@Icons.Material.Sharp.AlignHorizontalRight"
                                    OnClick="() => Format.HorizontalAlign = BlazorServer.Modules.Reports.Domain.Views.Align.End"
                                    Class="border border-solid" 
                                    Enabled="@Enabled" />

                <IsActiveIconButton IsActive="Format!.IsUnderline" 
                                    Icon="@Icons.Material.Sharp.FormatUnderlined" 
                                    OnClick="() => Format.IsUnderline = !Format.IsUnderline" 
                                    Class="border border-solid" 
                                    Enabled="@Enabled" />

                <div class="relative">
                    <IsActiveIconButton IsActive="false" 
                                        Icon="@Icons.Material.Sharp.FormatColorText" 
                                        OnClick="() => ShowColorPicker = !ShowColorPicker" 
                                        Class="border border-solid" 
                                        Style="@($"color: {Format.Color}; border-color: var(--mud-palette-text-primary);")" 
                                        Enabled="@Enabled" />

                    <MudOverlay Visible="ShowColorPicker" OnClick="OnOverlayClicked" />
                    <MudColorPicker PickerVariant="PickerVariant.Static"
                                    Class="absolute z-10"
                                    Elevation="4"
                                    ThrottleInterval="200"
                                    Style="@(ShowColorPicker ? "display: block;" : "display: none;")"
                                    Value="new MudBlazor.Utilities.MudColor(Format!.Color)"
                                    ValueChanged="@OnColorChanged"
                                    ShowAlpha="false"
                                    ShowModeSwitch="true" />
                </div>


            </div>
        </div>
       
        <hr class="vertical-divider" />

        <div class="column" style="min-width: 255px;">
            
            <div class="row">
                <KipSelect Style="width: 80px; height: 36px;" TItem="TextType" Items="@([TextType.PlainText, TextType.Number, TextType.DateTime])" ItemTextFunc="TypeString" @bind-SelectedItem="Format!.Type" />
                @if (Format!.Type == TextType.Number)
                {
                    <input class="kip-input" style="width: 36px;" @bind="Format!.DecimalCount" />
                }
                else if (Format!.Type == TextType.DateTime)
                {
                    <KipSelect Style="width: 170px;" TItem="string" Items="@(["yyyy-MM-dd", "yyyy-MM-dd HH:ss"])" @bind-SelectedItem="Format!.DayTimeFormat" />
                }
            </div>
            <div class="row">
                <input class="kip-input row-height" style="width: 150px;" @bind="Format!.FontFamily" placeholder="@Localizer["Teckensnitt"]" />
                <input class="kip-input row-height" style="width: 36px;" @bind="Format!.FontSize" />
            </div>
        </div>
        
        @* <hr class="vertical-divider" />

        <div class="column">
            <div class="row">
                
            </div>
            <div class="row">
                
            </div>
        </div> *@

    </div>
}



@code {
    [Parameter] public TextFormat? Format { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;

    bool ShowColorPicker = false;
    string baseRowClass => Enabled ? "row" : "row disabled";

    string TypeString(TextType type)
    {
        var typeString = type switch
        {
            TextType.PlainText => Localizer["Text"],
            TextType.Number => Localizer["Tal"],
            TextType.DateTime => Localizer["Datum"],
            _ => string.Empty
        };
        return typeString;
    }


    void OnOverlayClicked()
    {
        ShowColorPicker = false;
    }

    Task OnColorChanged(MudBlazor.Utilities.MudColor color)
    {
        if (Format is not null)
        {
            Format.Color = color.ToString(MudBlazor.Utilities.MudColorOutputFormats.Hex);
        }
        return Task.CompletedTask;
    }


}
