<table class="sheet-section">
    <colgroup>
        @foreach (var column in VisibleColumns)
        {
            <col style="@ColumnPercentWidth(column)" />
        }
    </colgroup>
    <tbody>
        <tr>
            @foreach (var column in VisibleColumns)
            {
                <th>@DisplayName(column.ColumnType)</th>
            }
        </tr>
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public SheetSection SheetSection { get; set; } = SheetSection.Create();

    private IReadOnlyList<BlazorServer.Modules.Reports.Domain.Views.SheetSections.ColumnDefinition> VisibleColumns
        => SheetSection.Columns.Where(column => column.IsVisible).ToArray();

    private double TableWidth => VisibleColumns.Sum(column => column.RelativeWidth);

    private string ColumnPercentWidth(BlazorServer.Modules.Reports.Domain.Views.SheetSections.ColumnDefinition column)
    {
        if (TableWidth <= 0)
        {
            return string.Empty;
        }

        return $"""width: {(column.RelativeWidth / TableWidth * 100).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}%""";
    }

    private static string DisplayName(ColumnType columnType)
        => columnType.ToString();
}
