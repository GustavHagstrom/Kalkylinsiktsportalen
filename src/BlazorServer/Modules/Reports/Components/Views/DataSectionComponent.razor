<table class="@Class">
    <colgroup>
        @foreach (var column in DataSection.ColumnDefinitions.OrderBy(x => x.ColumnIndex))
        {
            <col style="@ColumnPercentWidth(column)"/>
        }
    </colgroup>
    <tbody>
        @foreach(var row in DataSection.RowDefinitions.OrderBy(x => x.RowIndex))
        {
            <tr style="@RowHeight(row)">
                @foreach(var column in DataSection.ColumnDefinitions.OrderBy(x => x.ColumnIndex))
                {
                    var cell = GetDataCell(row, column);
                    <DataCellComponent DataCell="cell" EditMode="@EditMode" IsSelected="cell == SelectedDataCell" OnClick="() => OnCellClick.InvokeAsync(new DataSectionSelection(DataSection, cell))"/>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public DataSection DataSection { get; set; } = new DataSection();
    [Parameter] public DataCell? SelectedDataCell { get; set; }
    [Parameter] public bool EditMode { get; set; } = false;
    [Parameter] public EventCallback<DataSectionSelection> OnCellClick { get; set; }

    string Class => EditMode ? (SelectedDataCell is not null ? "data-table edit-mode selected" : "data-table edit-mode") : "data-table";

    protected override void OnParametersSet()
    {
        DataSection.Normalize();
    }

    double TableWidth => DataSection.ColumnDefinitions.Sum(x => x.RelativeWidth);
    string ColumnPercentWidth(DataColumnDefinition column) => $"""width: {(column.RelativeWidth / TableWidth * 100).ToString("F2")}%""";

    //row height in mm, 
    string RowHeight(RowDefinition row) => $"""height: {row.HeightMm}mm""";

    DataCell GetDataCell(RowDefinition row, DataColumnDefinition column)
    {
        return DataSection.GetCell(row.RowIndex, column.ColumnIndex);
    }



}
