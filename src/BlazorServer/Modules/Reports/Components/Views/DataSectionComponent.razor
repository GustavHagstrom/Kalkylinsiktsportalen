<table class="@Class">
    <colgroup>
        @foreach (var column in DataSection.Columns)
        {
            <col style="@ColumnPercentWidth(column)"/>
        }
    </colgroup>
    <tbody>
        @for (var rowIndex = 0; rowIndex < DataSection.Rows.Count; rowIndex++)
        {
            var row = DataSection.Rows[rowIndex];
            <tr style="@RowHeight(row)">
                @for (var columnIndex = 0; columnIndex < DataSection.Columns.Count; columnIndex++)
                {
                    var cell = GetDataCell(rowIndex, columnIndex);
                    <DataCellComponent DataCell="cell" EditMode="@EditMode" IsSelected="cell == SelectedDataCell" OnClick="() => OnCellClick.InvokeAsync(new DataSectionSelection(DataSection, cell))"/>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public DataSection DataSection { get; set; } = DataSection.CreateDefault();
    [Parameter] public DataCell? SelectedDataCell { get; set; }
    [Parameter] public bool EditMode { get; set; } = false;
    [Parameter] public EventCallback<DataSectionSelection> OnCellClick { get; set; }

    string Class => EditMode ? (SelectedDataCell is not null ? "data-table edit-mode selected" : "data-table edit-mode") : "data-table";

    double TableWidth => DataSection.Columns.Sum(x => x.RelativeWidth);
    string ColumnPercentWidth(BlazorServer.Modules.Reports.Domain.Views.DataSections.ColumnDefinition column) => $"""width: {(column.RelativeWidth / TableWidth * 100).ToString("F2")}%""";

    //row height in mm, 
    string RowHeight(RowDefinition row) => $"""height: {row.HeightMm}mm""";

    DataCell GetDataCell(int rowIndex, int columnIndex)
        => DataSection.GetCell(rowIndex, columnIndex);



}
