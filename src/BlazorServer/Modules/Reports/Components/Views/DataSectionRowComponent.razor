<table class="data-table">
    <colgroup>
        @foreach (var column in OrderedColumns)
        {
            <col style="@ColumnPercentWidth(column)" />
        }
    </colgroup>
    <tbody>
        <tr style="@RowHeight">
            @foreach (var column in OrderedColumns)
            {
                <DataCellComponent DataCell="@GetDataCell(column)" />
            }
        </tr>
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public DataSection DataSection { get; set; } = new();
    [Parameter, EditorRequired] public RowDefinition RowDefinition { get; set; } = new();

    private IReadOnlyList<DataColumnDefinition> OrderedColumns
        => DataSection.ColumnDefinitions.OrderBy(column => column.ColumnIndex).ToArray();

    private double TableWidth => DataSection.ColumnDefinitions.Sum(column => column.RelativeWidth);
    private string RowHeight => $"""height: {RowDefinition.HeightMm}mm""";

    private string ColumnPercentWidth(DataColumnDefinition column)
    {
        if (TableWidth <= 0)
        {
            return string.Empty;
        }

        return $"""width: {(column.RelativeWidth / TableWidth * 100).ToString("F2")}%""";
    }

    private DataCell GetDataCell(DataColumnDefinition column)
    {
        var key = $"R{RowDefinition.RowIndex}C{column.ColumnIndex}";
        return DataSection.DataCells.TryGetValue(key, out var cell)
            ? cell
            : new DataCell { RowIndex = RowDefinition.RowIndex, ColumnIndex = column.ColumnIndex };
    }
}
