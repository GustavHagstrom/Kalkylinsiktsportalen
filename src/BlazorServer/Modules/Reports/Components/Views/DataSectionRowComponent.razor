<table class="data-table">
    <colgroup>
        @for (var columnIndex = 0; columnIndex < OrderedColumns.Count; columnIndex++)
        {
            var column = OrderedColumns[columnIndex];
            <col style="@ColumnPercentWidth(column)" />
        }
    </colgroup>
    <tbody>
        <tr style="@RowHeight">
            @for (var columnIndex = 0; columnIndex < OrderedColumns.Count; columnIndex++)
            {
                <DataCellComponent DataCell="@DataSection.GetCell(RowIndex, columnIndex)" />
            }
        </tr>
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public DataSection DataSection { get; set; } = new();
    [Parameter, EditorRequired] public RowDefinition RowDefinition { get; set; } = new(8);
    [Parameter, EditorRequired] public int RowIndex { get; set; }

    private IReadOnlyList<BlazorServer.Modules.Reports.Domain.Views.DataSections.ColumnDefinition> OrderedColumns
        => DataSection.Columns;

    private double TableWidth => DataSection.Columns.Sum(column => column.RelativeWidth);
    private string RowHeight => $"""height: {RowDefinition.HeightMm}mm""";

    private string ColumnPercentWidth(BlazorServer.Modules.Reports.Domain.Views.DataSections.ColumnDefinition column)
    {
        if (TableWidth <= 0)
        {
            return string.Empty;
        }

        return $"""width: {(column.RelativeWidth / TableWidth * 100).ToString("F2")}%""";
    }

}
