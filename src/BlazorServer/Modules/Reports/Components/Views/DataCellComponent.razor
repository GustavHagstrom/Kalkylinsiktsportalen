@using BlazorServer.Modules.Reports.Rendering

<td class="@Class" style="@FormatBuilder.BuildCellStyle(EffectiveCellLayout)" @onclick="() => OnClick.InvokeAsync(DataCell)"> 
    <div style="@FormatBuilder.BuildTextStyle(EffectiveTextStyle, DisplayType)">
        @if (EditMode)
        {
            @DataCell.CellExpression
        }
        else
        {
            @DataCellFormulaEvaluator.GetDisplayValue(DataCell)
        }
    </div>    
</td>

@code {

    [Parameter, EditorRequired] public DataCell DataCell { get; set; }
    [Parameter] public bool EditMode { get; set; } = false;
    [Parameter] public bool IsSelected { get; set; } = false;
    [Parameter] public EventCallback<DataCell> OnClick { get; set; }


    string Class => EditMode ? (IsSelected ? "data-cell edit-mode selected" : "data-cell edit-mode") : "data-cell";

    CellLayout? EffectiveCellLayout => DataCell.CellLayout ?? DataCell.CellFormat?.ToCellLayout();
    TextStyle? EffectiveTextStyle => DataCell.TextStyle ?? DataCell.TextFormat?.ToTextStyle();

    ValueDisplayType DisplayType => (DataCell.ValueFormat ?? DataCell.TextFormat?.ToValueFormat())?.Kind switch
    {
        ValueFormatKind.Number => ValueDisplayType.Number,
        ValueFormatKind.Date or ValueFormatKind.DateTimeMinute => ValueDisplayType.DateTime,
        _ => ValueDisplayType.Text
    };
}
