@using BlazorServer.Modules.Reports.Rendering

<td class="@Class" style="@FormatBuilder.BuildCellStyle(DataCell.CellFormat)" @onclick="() => OnClick.InvokeAsync(DataCell)"> 
    <div style="@FormatBuilder.BuildTextStyle(DataCell.TextFormat)">
        @if (EditMode)
        {
            @DataCell.CellExpression
        }
        else
        {
            @DataCellFormulaEvaluator.GetDisplayValue(DataCell)
        }
    </div>    
</td>

@code {

    [Parameter, EditorRequired] public DataCell DataCell { get; set; }
    [Parameter] public bool EditMode { get; set; } = false;
    [Parameter] public bool IsSelected { get; set; } = false;
    [Parameter] public EventCallback<DataCell> OnClick { get; set; }


    string Class => EditMode ? (IsSelected ? "data-cell edit-mode selected" : "data-cell edit-mode") : "data-cell";
}
