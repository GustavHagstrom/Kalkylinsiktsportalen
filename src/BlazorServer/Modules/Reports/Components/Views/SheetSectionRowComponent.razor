<table class="sheet-section">
    <colgroup>
        @foreach (var column in VisibleColumns)
        {
            <col style="@ColumnPercentWidth(column)" />
        }
    </colgroup>
    <tbody>
        <tr>
            @foreach (var column in VisibleColumns)
            {
                var sheetColumnKind = column.SheetColumnKind;
                var cell = GetSheetCell(sheetColumnKind);
                <td style="@FormatBuilder.BuildCellStyle(EffectiveCellLayout(cell))">
                    <div style="@FormatBuilder.BuildTextStyle(EffectiveTextStyle(cell), DisplayType(cell))">
                        @if (!cell.HideValue)
                        {
                            @DisplayValue(sheetColumnKind)
                        }
                    </div>
                </td>
            }
        </tr>
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public SheetSection SheetSection { get; set; } = SheetSection.Create();
    [Parameter, EditorRequired] public RowType RowType { get; set; }

    private IReadOnlyList<SheetColumnConfiguration> VisibleColumns
        => SheetSection.Columns.Where(column => column.IsVisible).ToArray();

    private double TableWidth => VisibleColumns.Sum(column => column.RelativeWidth);

    private string ColumnPercentWidth(SheetColumnConfiguration column)
    {
        if (TableWidth <= 0)
        {
            return string.Empty;
        }

        return $"""width: {(column.RelativeWidth / TableWidth * 100).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}%""";
    }

    private SheetCell GetSheetCell(SheetColumnKind sheetColumnKind)
    {
        var key = new SheetCellKey(sheetColumnKind, RowType);
        return SheetSection.SheetCells.TryGetValue(key, out var cell)
            ? cell
            : SheetCell.CreateDefault(sheetColumnKind, RowType);
    }

    private static CellLayout? EffectiveCellLayout(SheetCell cell)
        => cell.CellLayout;

    private static TextStyle? EffectiveTextStyle(SheetCell cell)
        => cell.TextStyle;

    private static ValueDisplayType DisplayType(SheetCell cell)
        => cell.ValueFormat?.Kind switch
        {
            ValueFormatKind.Number => ValueDisplayType.Number,
            ValueFormatKind.Date or ValueFormatKind.DateTimeMinute => ValueDisplayType.DateTime,
            _ => ValueDisplayType.Text
        };

    private string DisplayValue(SheetColumnKind sheetColumnKind)
        => sheetColumnKind switch
        {
            SheetColumnKind.Description => SheetSection.SheetKind == SheetKind.TenderSheet
                ? RowType.ToString()
                : SheetSection.SheetKind.ToString(),
            _ => string.Empty
        };
}
