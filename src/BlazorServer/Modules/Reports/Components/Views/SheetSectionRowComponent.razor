<table class="sheet-section">
    <tbody>
        <tr>
            @foreach (var columnType in OrderedColumnTypes)
            {
                var cell = GetSheetCell(columnType);
                <td style="@FormatBuilder.BuildCellStyle(EffectiveCellLayout(cell))">
                    <div style="@FormatBuilder.BuildTextStyle(EffectiveTextStyle(cell), DisplayType(cell))">
                        @if (!cell.HideValue)
                        {
                            @DisplayValue(columnType)
                        }
                    </div>
                </td>
            }
        </tr>
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public SheetSection SheetSection { get; set; } = new();
    [Parameter, EditorRequired] public RowType RowType { get; set; }

    private static IReadOnlyList<ColumnType> OrderedColumnTypes { get; } = Enum.GetValues<ColumnType>();

    private SheetCell GetSheetCell(ColumnType columnType)
    {
        var key = new SheetCellKey(columnType, RowType);
        return SheetSection.SheetCells.TryGetValue(key, out var cell)
            ? cell
            : SheetCell.CreateDefault(columnType, RowType);
    }

    private static CellLayout? EffectiveCellLayout(SheetCell cell)
        => cell.CellLayout;

    private static TextStyle? EffectiveTextStyle(SheetCell cell)
        => cell.TextStyle;

    private static ValueDisplayType DisplayType(SheetCell cell)
        => cell.ValueFormat?.Kind switch
        {
            ValueFormatKind.Number => ValueDisplayType.Number,
            ValueFormatKind.Date or ValueFormatKind.DateTimeMinute => ValueDisplayType.DateTime,
            _ => ValueDisplayType.Text
        };

    private string DisplayValue(ColumnType columnType)
        => columnType switch
        {
            ColumnType.Description => SheetSection.SourceType == SheetSourceType.TenderSheet
                ? RowType.ToString()
                : SheetSection.SourceType.ToString(),
            _ => string.Empty
        };
}
