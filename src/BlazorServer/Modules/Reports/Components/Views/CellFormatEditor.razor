@inject IStringLocalizer<CellFormatEditor> Localizer



@if(Format is null)
{
    
}
else
{
    <div class="@baseRowClass">

        <div class="column">
            <div class="row">
                <IsActiveIconButton IsActive="SelectedBorderSide == BorderSide.Top"
                                    Icon="@Icons.Material.Sharp.BorderTop"
                                    OnClick="() => SelectedBorderSide = BorderSide.Top"
                                    Class="border border-solid"
                                    Enabled="@Enabled" />
                <IsActiveIconButton IsActive="SelectedBorderSide == BorderSide.Left"
                                    Icon="@Icons.Material.Sharp.BorderLeft"
                                    OnClick="() => SelectedBorderSide = BorderSide.Left"
                                    Class="border border-solid"
                                    Enabled="@Enabled" />
                <IsActiveIconButton IsActive="SelectedBorderSide == BorderSide.Right"
                                    Icon="@Icons.Material.Sharp.BorderRight"
                                    OnClick="() => SelectedBorderSide = BorderSide.Right"
                                    Class="border border-solid"
                                    Enabled="@Enabled" />
                <IsActiveIconButton IsActive="SelectedBorderSide == BorderSide.Bottom"
                                    Icon="@Icons.Material.Sharp.BorderBottom"
                                    OnClick="() => SelectedBorderSide = BorderSide.Bottom"
                                    Class="border border-solid"
                                    Enabled="@Enabled" />
            </div>
            <div class="row">
                <IsActiveIconButton IsActive="SelectedBorder.IsBorder"
                                    Icon="@Icons.Material.Sharp.BorderOuter"
                                    OnClick="ToggleSelectedBorder"
                                    Class="border border-solid"
                                    Enabled="@Enabled" />

                <div class="relative">
                    <IsActiveIconButton IsActive="ActiveColorPicker == ColorPickerTarget.Background && ShowColorPicker"
                                        Icon="@Icons.Material.Sharp.FormatColorFill"
                                        OnClick="() => ToggleColorPicker(ColorPickerTarget.Background)"
                                        Class="border border-solid"
                                        Style="@($"color: {Format.BackgroundColor}; border-color: var(--mud-palette-text-primary);")"
                                        Enabled="@Enabled" />
                </div>

                <div class="relative">
                    <IsActiveIconButton IsActive="ActiveColorPicker == ColorPickerTarget.Border && ShowColorPicker"
                                        Icon="@Icons.Material.Sharp.BorderColor"
                                        OnClick="() => ToggleColorPicker(ColorPickerTarget.Border)"
                                        Class="border border-solid"
                                        Style="@($"color: {SelectedBorder.BorderColor}; border-color: var(--mud-palette-text-primary);")"
                                        Enabled="@Enabled" />

                    <MudOverlay Visible="ShowColorPicker" OnClick="OnOverlayClicked" />
                    <MudColorPicker PickerVariant="PickerVariant.Static"
                                    Class="absolute z-10"
                                    Elevation="4"
                                    ThrottleInterval="200"
                                    Style="@(ShowColorPicker ? "display: block;" : "display: none;")"
                                    Value="CurrentColor"
                                    ValueChanged="@OnColorChanged"
                                    ShowAlpha="false"
                                    ShowModeSwitch="true" />
                </div>


            </div>
        </div>
       
        <hr class="vertical-divider" />

        <div class="column">
            <div class="row">
                <input class="kip-input row-height" style="width: 70px;" @bind="Format!.PaddingLeft" placeholder="@Localizer["V�nster"]" />
                <input class="kip-input row-height" style="width: 70px;" @bind="Format!.PaddingRight" placeholder="@Localizer["H�ger"]" />
            </div>
            <div class="row">
                <input class="kip-input row-height" style="width: 70px;" @bind="Format!.PaddingTop" placeholder="@Localizer["Topp"]" />
                <input class="kip-input row-height" style="width: 70px;" @bind="Format!.PaddingBottom" placeholder="@Localizer["Botten"]" />
            </div>
        </div>
        
        <hr class="vertical-divider" />

        <div class="column">
            <div class="row">
                <KipSelect Style="width: 120px; height: 36px;" TItem="string" Items="@BorderFormats" @bind-SelectedItem="SelectedBorder.BorderStyle" />
            </div>
            <div class="row">
                <input class="kip-input row-height" style="width: 48px;" @bind="SelectedBorder.BorderWidth" />
            </div>
        </div>

    </div>
}



@code {
    [Parameter] public CellFormat? Format { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;

    string baseRowClass => Enabled ? "row" : "row disabled";
    bool ShowColorPicker = false;
    ColorPickerTarget ActiveColorPicker = ColorPickerTarget.None;
    BorderSide SelectedBorderSide = BorderSide.Top;
    List<string> BorderFormats = ["Solid", "Dashed", "Dotted", "Double", "None"];

    BorderFormat SelectedBorder => SelectedBorderSide switch
    {
        BorderSide.Left => Format?.LeftBorder ?? new BorderFormat(),
        BorderSide.Right => Format?.RightBorder ?? new BorderFormat(),
        BorderSide.Bottom => Format?.BottomBorder ?? new BorderFormat(),
        _ => Format?.TopBorder ?? new BorderFormat()
    };

    MudBlazor.Utilities.MudColor CurrentColor => ActiveColorPicker switch
    {
        ColorPickerTarget.Border => new MudBlazor.Utilities.MudColor(SelectedBorder.BorderColor),
        _ => new MudBlazor.Utilities.MudColor(Format?.BackgroundColor ?? "#FFFFFF")
    };


    void OnOverlayClicked()
    {
        ShowColorPicker = false;
        ActiveColorPicker = ColorPickerTarget.None;
    }

    void ToggleSelectedBorder()
    {
        SelectedBorder.IsBorder = !SelectedBorder.IsBorder;
    }

    void ToggleColorPicker(ColorPickerTarget target)
    {
        if (ShowColorPicker && ActiveColorPicker == target)
        {
            ShowColorPicker = false;
            ActiveColorPicker = ColorPickerTarget.None;
            return;
        }

        ActiveColorPicker = target;
        ShowColorPicker = true;
    }

    Task OnColorChanged(MudBlazor.Utilities.MudColor color)
    {
        if (Format is not null)
        {
            var hexColor = color.ToString(MudBlazor.Utilities.MudColorOutputFormats.Hex);

            if (ActiveColorPicker == ColorPickerTarget.Border)
            {
                SelectedBorder.BorderColor = hexColor;
            }
            else
            {
                Format.BackgroundColor = hexColor;
            }
        }

        return Task.CompletedTask;
    }

    enum BorderSide
    {
        Top,
        Left,
        Right,
        Bottom
    }

    enum ColorPickerTarget
    {
        None,
        Background,
        Border
    }


}
