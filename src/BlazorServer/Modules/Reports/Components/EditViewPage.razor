@page "/Settings/views/{ViewId}"
@using BlazorServer.Kernel.CQRS
@using BlazorServer.Modules.Reports.Features.GetView
@using BlazorServer.Modules.Reports.Features.UpdateView
@using BlazorServer.Modules.Reports.Public
@using BlazorServer.Modules.Reports.Domain.Views
@using BlazorServer.Modules.Reports.Domain.Views.DataSection
@using BlazorServer.Modules.Reports.Components.Rendering.PrintableDocuments

@if(View is not null)
{
    <ToolbarPage IsLoading="isLoading" Height="88px">
        <LeftToolbarContent>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AddSection(SectionType.Data))">@Localizer["Lägg till datasektion"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AddSection(SectionType.Sheet))">@Localizer["Lägg till bladsektion"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveView">@Localizer["Spara"]</MudButton>

            <KipTextField TValue="string" @bind-Value="ViewName" Label="@Localizer["Namn"]" />

            @if (SelectedItem is DataSectionSelection selection)
            {
                <IsActiveIconButton Icon="@Icons.Material.Sharp.PowerSettingsNew"
                                    IsActive="@TextFormatIsEnabled"
                                    OnClick="@ToggleTextFormat"
                                    Class="mx-2" />

                <CellFormatEditor Format="selection.DataCell.CellFormat" Enabled="@TextFormatIsEnabled" />
                <MudDivider Vertical="true" FlexItem="true" Class="mx-2"/>
                <TextFormatEditor Format="selection.DataCell.TextFormat" Enabled="@TextFormatIsEnabled" />
            }
        </LeftToolbarContent>
        <ChildContent>
            <div class="full-height pa-4 d-flex gap-4">
                <MudPaper Class="full-height flex-grow-1 pa-1 gap-1 d-flex flex-column" Style="overflow: auto; min-width: 300px;">
                    @foreach(var section in View.LegacyDataSections.OrderBy(x => x.SectionIndex))
                    {
                        var selectedCell = SelectedItem is DataSectionSelection selection && selection.DataSection == section ? selection.DataCell : null;
                        <div class="d-flex justify-end">
                            <MudIconButton Icon="@Icons.Material.Sharp.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => ConfirmRemoveDataSectionAsync(section))" />
                        </div>
                        <DataSectionComponent DataSection="section" EditMode="true" SelectedDataCell="selectedCell" OnCellClick="x => SelectedItem = x"/>
                    }
                </MudPaper>
                <div class="full-height overflow-auto pr-4">
                    <PrintableDocumentRenderer Document="@Document" />
                </div>
            </div>
        </ChildContent>
    </ToolbarPage>
}

@inject IStringLocalizer<EditViewPage> Localizer
@inject IQueryHandler<GetViewQuery, GetViewResult> GetView
@inject ICommandHandler<UpdateViewCommand, UpdateViewResult> UpdateView
@inject ICurrentAccessSubject CurrentAccessSubject
@inject IViewAccessDecisionService ViewAccessDecisions
@inject IDialogService DialogService

@code {
    [Parameter] public string? ViewId { get; set; }

    View? View { get; set; }
    string ViewName { get; set; } = string.Empty;
    bool isLoading = false;
    bool TextFormatIsEnabled = true;
    UpdateViewResult? LastSaveResult = null;
    object? SelectedItem = null;
    PrintableDocumentBuilder DocumentBuilder { get; } = new();
    PrintableDocument? Document => View is null ? null : DocumentBuilder.Build(View, ReportRenderingContext.ForViewPreview(View));

    enum SectionType
    {
        Data,
        Sheet
    }

    void ToggleTextFormat()
    {
        TextFormatIsEnabled = !TextFormatIsEnabled;
    }

    protected override Task OnInitializedAsync()
    {
        return LoadDataAsync();
    }

    async Task LoadDataAsync()
    {
        if (ViewId is null) return;
        SetLoading(true);

        var subject = await CurrentAccessSubject.GetAsync();
        if (subject is null || !await ViewAccessDecisions.CanEditViewAsync(subject, ViewId))
        {
            View = null;
            SetLoading(false);
            return;
        }

        var result = await GetView.HandleAsync(
            new GetViewQuery(new ViewId(ViewId)),
            CancellationToken.None);

        View = result is ViewLoaded loaded ? loaded.View : null;
        ViewName = View?.Name ?? string.Empty;
        SetLoading(false);
    }

    void SetLoading(bool loading)
    {
        isLoading = loading;
        StateHasChanged();
    }

    void AddSection(SectionType type)
    {
        if(View is null) return;
        switch(type)
        {
            case SectionType.Data:
                View.AddDataSection();
                break;
            case SectionType.Sheet:
                View.AddSheetSection();
                break;
        }
    }

    async Task ConfirmRemoveDataSectionAsync(DataSection section)
    {
        if (View is null) return;

        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.Message, Localizer["Sektionen tas bort från den aktiva view-definitionen. Historiska ändringar kan fortfarande referera till sektionens identitet. Vill du fortsätta?"] },
            { x => x.ConfirmText, Localizer["Ta bort"] },
            { x => x.CancelText, Localizer["Avbryt"] }
        };
        var dialog = await DialogService.ShowAsync<ConfirmationDialog>(Localizer["Ta bort sektion"], parameters);
        var result = await dialog.Result;

        if (result != DialogResult.Cancel() && result?.Data is true)
            View.RemoveDataSection(section);
    }

    async Task SaveView()
    {
        if (View is null) return;
        var subject = await CurrentAccessSubject.GetAsync();
        if (subject is null || !await ViewAccessDecisions.CanEditViewAsync(subject, View.Id.Value))
        {
            LastSaveResult = null;
            return;
        }

        SetLoading(true);
        try
        {
            LastSaveResult = await UpdateView.HandleAsync(
                new UpdateViewCommand(
                    subject.OrganizationId,
                    View.Id,
                    ViewName,
                    View.Description,
                    View.LegacyDataSections,
                    View.LegacySheetSections),
                CancellationToken.None);
        }
        finally
        {
            SetLoading(false);
        }
    }
}
