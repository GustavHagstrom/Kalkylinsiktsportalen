@using BlazorServer.Modules.Reports.Public.Contracts.PrintableDocuments
@using BlazorServer.Modules.Reports.Domain.PrintableDocuments
@implements IAsyncDisposable

<HeadContent>
    <link href="@Assets["Pageination/styles.css"]" rel="stylesheet" />
</HeadContent>

    
<div id="print-wrapper">
    
    <div @ref="RendererRoot" id="print-root" class="d-flex flex-column gap-4 relative" data-printable-renderer-state="@RendererState.Status" style="@($"width: {RenderPageFormat.WidthMm}mm;")">
        @if (RendererState.Status is PrintableRendererStatus.Measuring or PrintableRendererStatus.Paginating)
        {
            <div class="printable-renderer-status print-hide" aria-live="polite">@RendererStatusText</div>
        }
        @if (ShowPaginationOverlay && (RendererState.Status is PrintableRendererStatus.Measuring or PrintableRendererStatus.Paginating))
        {
            <MudOverlay Absolute="true" DarkBackground="true" Visible="true">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            </MudOverlay>
        }
        @if (RendererState.Status is PrintableRendererStatus.Measuring or PrintableRendererStatus.Paginating)
        {
            BodyBlockMap.Clear();
            foreach (var block in HeaderBlocks)
            {
                <div class="header-block" data-printable-region="header">
                    <DynamicComponent Type="@block.ComponentType" Parameters="@ToDynamicParameters(block)" />
                </div>
            }
            foreach (var block in BodyBlocks)
            {
                RegisterBodyBlock(block);
                <div class="body-block" data-printable-region="body" data-printable-block-id="@block.Id" data-page-break-behavior="@block.PageBreakBehavior">
                    <DynamicComponent Type="@block.ComponentType" Parameters="@ToDynamicParameters(block)" />
                </div>
            }
            foreach (var block in FooterBlocks)
            {
                <div class="footer-block" data-printable-region="footer">
                    <DynamicComponent Type="@block.ComponentType" Parameters="@ToDynamicParameters(block)" />
                </div>
            }
        }
        else
        {
            if (RendererState.Errors.Count > 0)
            {
                foreach (var error in RendererState.Errors)
                {
                    <MudAlert Severity="Severity.Error">@error.Message</MudAlert>
                }
            }
            else
            {
                foreach (var page in RendererState.Pages.OrderBy(page => page.PageNumber))
                {
                    <div class="@PageClass" style="@PageStyle">

                        <div class="header">
                            @foreach (var block in HeaderBlocks)
                            {
                                <DynamicComponent Type="@block.ComponentType" Parameters="@ToDynamicParameters(block)" />
                            }
                        </div>

                        <div class="body" style="@BodyRegionStyle(page)">
                            @foreach (var placement in page.BodyBlocks)
                            {
                                var block = GetMappedBodyBlock(placement.BlockId);
                                <div class="body-placement-block" data-printable-block-id="@placement.BlockId" style="@BodyPlacementStyle(placement)">
                                    <DynamicComponent Type="@block.ComponentType" Parameters="@ToDynamicParameters(block)" />
                                </div>
                            }
                        </div>

                        <div class="footer">
                            @foreach (var block in FooterBlocks)
                            {
                                <DynamicComponent Type="@block.ComponentType" Parameters="@ToDynamicParameters(block)" />
                            }
                        </div>
                    </div>

                }
            }
        }
    </div>
</div>




@inject IJSRuntime JS

@code {
    [Parameter] public BlazorServer.Modules.Reports.Public.Contracts.PrintableDocuments.PrintableDocument? Document { get; set; }
    [Parameter] public bool ShowPaginationOverlay { get; set; } = true;

    /// <summary>
    /// ComponentType needs to be a Blazor Component
    /// </summary>
    [Parameter] public List<(Type ComponentType, Dictionary<string, object> Parameters)> BodyComponents { get; set; } =
    [
        new (typeof(Demo), new Dictionary<string, object>() { { nameof(Demo.Test), "Komponent 1" } }),
        new (typeof(Demo3), new()),
        new (typeof(Demo), new Dictionary<string, object>() { { nameof(Demo.Test), "Komponent 3" } }),
        new (typeof(Demo), new Dictionary<string, object>() { { nameof(Demo.Test), "Komponent 4" } }),
        new (typeof(Demo2), new Dictionary<string, object>() { { nameof(Demo2.Test), "Komponent 5" } }),
        new (typeof(Demo2), new Dictionary<string, object>() { { nameof(Demo2.Test), "Komponent 6" } }),
        new (typeof(Demo), new Dictionary<string, object>() { { nameof(Demo.Test), "Komponent 7" } }),
        new (typeof(Demo2), new Dictionary<string, object>() { { nameof(Demo2.Test), "Komponent 8" } }),
        new (typeof(Demo), new Dictionary<string, object>() { { nameof(Demo.Test), "Komponent 9" } }),
        new (typeof(Demo2), new Dictionary<string, object>() { { nameof(Demo2.Test), "Komponent 10" } }),
    ];
    /// <summary>
    /// ComponentType needs to be a Blazor Component
    /// </summary>
    [Parameter] public List<(Type ComponentType, Dictionary<string, object> Parameters)> HeaderComponents { get; set; } =
    [
        new (typeof(Demo), new Dictionary<string, object>() { { nameof(Demo.Test), "Header Komponent 1" } }),
        new (typeof(Demo2), new Dictionary<string, object>() { { nameof(Demo2.Test), "Header Komponent 2" } }),

    ];
    /// <summary>
    /// ComponentType needs to be a Blazor Component
    /// </summary>
    [Parameter] public List<(Type ComponentType, Dictionary<string, object> Parameters)> FooterComponents { get; set; } =
    [
        new (typeof(Demo), new Dictionary<string, object>() { { nameof(Demo.Test), "Footer Komponent 1" } }),
        new (typeof(Demo2), new Dictionary<string, object>() { { nameof(Demo2.Test), "Footer Komponent 2" } }),
    ];


    string PageClass => $"page {FormatClass}";
    string PageStyle => $"width: {RenderPageFormat.WidthMm}mm; height: {RenderPageFormat.HeightMm}mm;";
    string RendererStatusText => RendererState.Status switch
    {
        PrintableRendererStatus.Measuring => "Measuring printable document",
        PrintableRendererStatus.Paginating => "Paginating printable document",
        PrintableRendererStatus.Error => "Printable document pagination failed",
        PrintableRendererStatus.Ready => "Printable document preview ready",
        _ => "Printable document renderer"
    };
    string FormatClass => RenderPageFormat.Name switch
    {
        "A4" => "A4",
        "A3" => "A3",
        "A5" => "A5",
        _ => string.Empty
    };
    PrintableDocumentRendererState RendererState { get; } = new();
    public PageSizeFormat LegacyPageFormat { get; set; } = PageSizeFormat.A4;
    public enum PageSizeFormat
    {
        A4,
        A3,
    }
    Dictionary<PageSizeFormat, PageFormat> LegacyPageFormats { get; set; } = new()
    {
        { PageSizeFormat.A4, new PageFormat("A4", WidthMm: 210, HeightMm: 297) },
        { PageSizeFormat.A3, new PageFormat("A3", WidthMm: 297, HeightMm: 420) },
    };
    PageFormat RenderPageFormat => Document?.PageFormat ?? LegacyPageFormats[LegacyPageFormat];
    BlazorServer.Modules.Reports.Public.Contracts.PrintableDocuments.PrintableDocument RenderDocument => Document ?? new(
        Id: "legacy-printable-document",
        ChangeToken: "legacy-render",
        PageFormat: RenderPageFormat,
        HeaderItems: HeaderBlocks,
        BodyItems: BodyBlocks,
        FooterItems: FooterBlocks);
    IReadOnlyList<PrintableBlock> HeaderBlocks => Document is null
        ? ToLegacyBlocks("header", HeaderComponents)
        : FlattenPrintableBlocks(Document.HeaderItems);
    IReadOnlyList<PrintableBlock> BodyBlocks => Document is null
        ? ToLegacyBlocks("body", BodyComponents)
        : FlattenPrintableBlocks(Document.BodyItems);
    IReadOnlyList<PrintableBlock> FooterBlocks => Document is null
        ? ToLegacyBlocks("footer", FooterComponents)
        : FlattenPrintableBlocks(Document.FooterItems);

    /// <summary>
    /// key: PrintableBlock Id value, value: block rendered on that page
    /// </summary>
    Dictionary<string, PrintableBlock> BodyBlockMap { get; set; } = new(StringComparer.Ordinal);

    ElementReference RendererRoot { get; set; }
    PrintableDocumentMeasurementAdapter? MeasurementAdapter { get; set; }

    private static IReadOnlyList<PrintableBlock> ToLegacyBlocks(
        string idPrefix,
        IReadOnlyList<(Type ComponentType, Dictionary<string, object> Parameters)> components)
        => components
            .Select((component, index) => new PrintableBlock(
                $"{idPrefix}-{index + 1}",
                component.ComponentType,
                component.Parameters.ToDictionary(
                    parameter => parameter.Key,
                    parameter => (object?)parameter.Value,
                    StringComparer.Ordinal)))
            .ToArray();

    private static IReadOnlyList<PrintableBlock> FlattenPrintableBlocks(IReadOnlyList<PrintableItem> items)
    {
        var blocks = new List<PrintableBlock>();
        foreach (var item in items)
        {
            FlattenPrintableBlock(item, blocks);
        }

        return blocks;
    }

    private static void FlattenPrintableBlock(PrintableItem item, List<PrintableBlock> blocks)
    {
        switch (item)
        {
            case PrintableBlock block:
                blocks.Add(block);
                break;

            case PrintableContainer container:
                foreach (var child in container.Items)
                {
                    FlattenPrintableBlock(child, blocks);
                }

                break;

            default:
                throw new NotSupportedException($"Printable item '{item.Id}' has unsupported type '{item.GetType().Name}'.");
        }
    }

    private static Dictionary<string, object?> ToDynamicParameters(PrintableBlock block)
        => block.Parameters.ToDictionary(
            parameter => parameter.Key,
            parameter => parameter.Value,
            StringComparer.Ordinal);

    private void RegisterBodyBlock(PrintableBlock block)
    {
        if (!BodyBlockMap.TryAdd(block.Id, block))
        {
            throw new InvalidOperationException($"Printable document contains more than one body block with id '{block.Id}'.");
        }
    }

    private PrintableBlock GetMappedBodyBlock(string id)
    {
        if (BodyBlockMap.TryGetValue(id, out var block))
        {
            return block;
        }

        throw new InvalidOperationException($"Paginated body references unknown printable block id '{id}'.");
    }

    private static string BodyRegionStyle(PrintablePage page)
        => $"height: {page.BodyHeightMm}mm; position: relative;";

    private static string BodyPlacementStyle(PrintableBlockPlacement placement)
        => $"position: absolute; top: {placement.TopMm}mm; height: {placement.HeightMm}mm; left: 0; right: 0; overflow: hidden;";

    protected override void OnParametersSet()
    {
        RendererState.SetDocument(RenderDocument);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (RendererState.NeedsMeasurement)
        {
            return Paginate();
        }

        return Task.CompletedTask;
    }

    public async Task Paginate()
    {
        if (!RendererState.NeedsMeasurement)
        {
            return;
        }

        RendererState.MarkPaginating();
        MeasurementAdapter ??= new PrintableDocumentMeasurementAdapter(JS);
        try
        {
            var measurements = await MeasurementAdapter.MeasureAsync(RendererRoot);
            var pagination = new PrintableDocumentPaginator().Paginate(RenderDocument, measurements);
            RendererState.MarkReady(pagination);
        }
        catch (Exception exception)
        {
            RendererState.MarkError(new PaginationIssue(
                PaginationIssueCode.MeasurementFailed,
                $"The printable document could not be measured: {exception.Message}"));
        }

        StateHasChanged();

    }

    public Task RefreshPagination()
    {
        RendererState.RequestRefresh();
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (MeasurementAdapter is not null)
        {
            await MeasurementAdapter.DisposeAsync();
        }
    }
    
}
