@page "/settings/access"
@inject IStringLocalizer<SettingsPage> Localizer

<SettingsPageBase>
    
    <SettingsSection Title="@Localizer["Roller"]" LoadDataAsync="LoadRoleDataAsync">
        <RoleList Roles="Roles"/>
    </SettingsSection>

    <SettingsSection Title="@Localizer["Användare"]" LoadDataAsync="LoadUserDataAsync">
        <UserPicker AllUsers="Users" EnablePicking="false">
            <ExtraTdContent>
                <MudIconButton Icon="@Icons.Material.Sharp.Edit" Color="Color.Primary" OnClick="() => EditUserAccess(context)" Size="Size.Small" />
            </ExtraTdContent>
        </UserPicker>
    </SettingsSection>

</SettingsPageBase>

@inject ICurrentUserContext CurrentUserSession
@inject IAccessDirectory AccessDirectory
@inject NavigationManager NavigationManager

@code{
    List<AccessDirectoryRole> Roles { get; set; } = new();
    List<AccessDirectoryUser> Users { get; set; } = new();

    async Task LoadUserDataAsync()
    {
        Users.Clear();

        if (CurrentUserSession.CurrentUser?.OrganizationId is null)
        {
            StateHasChanged();
            return;
        }
        Users = await AccessDirectory.GetUsersAsync(CurrentUserSession.CurrentUser.OrganizationId);
        StateHasChanged();
    }
    async Task LoadRoleDataAsync()
    {
        Roles.Clear();

        if (CurrentUserSession.CurrentUser?.OrganizationId is null)
        {
            StateHasChanged();
            return;
        }
        Roles.AddRange(await AccessDirectory.GetRolesAsync(CurrentUserSession.CurrentUser.OrganizationId));
        StateHasChanged();
    }
    void EditUserAccess(AccessDirectoryUser user)
    {
        NavigationManager.NavigateTo($"{Constants.Routes.UserAccessEdit}/{user.Id}");
    }
}
