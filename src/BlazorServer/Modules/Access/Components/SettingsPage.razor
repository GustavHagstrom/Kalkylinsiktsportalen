@page "/settings/access"
@inject IStringLocalizer<SettingsPage> Localizer

<SettingsPageBase>
    
    <SettingsSection Title="@Localizer["Roller"]" LoadDataAsync="LoadRoleDataAsync">
        <RoleList Roles="Roles"/>
    </SettingsSection>

    <SettingsSection Title="@Localizer["Användare"]" LoadDataAsync="LoadUserDataAsync">
        <UserPicker AllUsers="Users" EnablePicking="false">
            <ExtraTdContent>
                <MudIconButton Icon="@Icons.Material.Sharp.Edit" Color="Color.Primary" OnClick="() => EditUserAccess(context)" Size="Size.Small" />
            </ExtraTdContent>
        </UserPicker>
    </SettingsSection>

</SettingsPageBase>

@inject ICurrentUserSession CurrentUserSession
@inject IUserService UserService
@inject IRoleService RoleService
@inject NavigationManager NavigationManager

@code{
    List<Role> Roles { get; set; } = new();
    List<User> Users { get; set; } = new();

    async Task LoadUserDataAsync()
    {
        Users.Clear();
        await CurrentUserSession.RefreshAsync();

        if (CurrentUserSession.OrganizationId is null)
        {
            StateHasChanged();
            return;
        }
        Users = await UserService.GetUsersAsync(CurrentUserSession.OrganizationId);
        StateHasChanged();
    }
    async Task LoadRoleDataAsync()
    {
        Roles.Clear();
        await CurrentUserSession.RefreshAsync();

        if (CurrentUserSession.OrganizationId is null)
        {
            StateHasChanged();
            return;
        }
        Roles.AddRange(await RoleService.GetRolesAsync(CurrentUserSession.OrganizationId));
        StateHasChanged();
    }
    void EditUserAccess(User user)
    {
        NavigationManager.NavigateTo($"{Constants.Routes.UserAccessEdit}/{user.Id}");
    }
}
