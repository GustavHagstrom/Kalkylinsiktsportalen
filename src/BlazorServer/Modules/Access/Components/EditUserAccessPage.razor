@page "/settings/access/users/{UserId}"
@inject IStringLocalizer<EditUserAccessPage> Localizer

<SettingsPageBase>

    <SettingsSection Title="@Localizer["Användare"]">
        <UserAvatarWithName Name="@User?.Name" AvatarBase64="@User?.AvatarBase64"/>
    </SettingsSection>

    <SettingsSection Title="@Localizer["Rättigheter"]" LoadDataAsync="LoadUserDataAsync">
        <MudOverlay DarkBackground="true" Visible="IsLoading" Absolute="true">
            <MudProgressCircular Size="Size.Large" Color="Color.Primary" Indeterminate="true" />
        </MudOverlay>
        <AccessClaimValuePicker PickedAccessClaimValues="UserAccessGrant?.AccessClaimValues ?? []" PickChanged="UserAccessCheckBoxClick" />
    </SettingsSection>

    <SettingsSection Title="@Localizer["Roller"]">
        <RoleList Roles="PickedRoles" />
    </SettingsSection>
</SettingsPageBase>

@inject FunctionalAccessGrantHandler FunctionalAccessGrants
@inject IAccessDirectory AccessDirectory
@inject ICurrentUserContext CurrentUserContext
@inject NavigationManager NavigationManager

@code{
    [Parameter] public UserId? UserId { get; set; }
    AccessDirectoryUser? User { get; set; }
    FunctionalAccessGrant? UserAccessGrant { get; set; }
    List<AccessDirectoryRole> AllRoles { get; set; } = [];
    List<AccessDirectoryRole> PickedRoles { get; set; } = [];

    bool IsLoading { get; set; } = false;

    async Task LoadUserDataAsync()
    {
        SetIsLoading(true);

        if (UserId is not null && CurrentUserContext.CurrentUser is not null)
        {
            UserAccessGrant = await FunctionalAccessGrants.HandleAsync(new GetUserFunctionalAccessQuery(UserId.Value, CurrentUserContext.CurrentUser.OrganizationId));
            User = await AccessDirectory.GetUserAsync(UserId.Value);
            AllRoles = await AccessDirectory.GetRolesAsync(CurrentUserContext.CurrentUser.OrganizationId);
            var pickedRoles = await AccessDirectory.GetRolesForUserAsync(UserId.Value, CurrentUserContext.CurrentUser.OrganizationId);
            PickedRoles = AllRoles.Where(r => pickedRoles.Any(pr => pr.Id == r.Id)).ToList();
        }
        SetIsLoading(false);
    }
    void SetIsLoading(bool isLoading)
    {
        IsLoading = isLoading;
        StateHasChanged();
    }
    Task UserAccessCheckBoxClick(PickChangedRecord<AccessClaimContribution> pickedRecord)
    {
        if (UserAccessGrant is null) return Task.CompletedTask;
        if (pickedRecord.IsPicked && !UserAccessGrant.AccessClaimValues.Contains(pickedRecord.Data.Value))
        {
            UserAccessGrant = new FunctionalAccessGrant(
                UserAccessGrant.Target,
                UserAccessGrant.OrganizationId,
                UserAccessGrant.AccessClaimValues.Append(pickedRecord.Data.Value));
            return FunctionalAccessGrants.HandleAsync(new GrantUserFunctionalAccessCommand(
                new UserId(UserAccessGrant.Target.Id),
                UserAccessGrant.OrganizationId,
                pickedRecord.Data.Value));
        }
        else
        {
            UserAccessGrant = new FunctionalAccessGrant(
                UserAccessGrant.Target,
                UserAccessGrant.OrganizationId,
                UserAccessGrant.AccessClaimValues.Where(value => value != pickedRecord.Data.Value));
            return FunctionalAccessGrants.HandleAsync(new RevokeUserFunctionalAccessCommand(
                new UserId(UserAccessGrant.Target.Id),
                UserAccessGrant.OrganizationId,
                pickedRecord.Data.Value));
        }
    }
}
