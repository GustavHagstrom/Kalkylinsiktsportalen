@page "/settings/access/users/{UserId}"
@inject IStringLocalizer<EditUserAccessPage> Localizer

<SettingsPageBase>

    <SettingsSection Title="@Localizer["Användare"]">
        <UserAvatarWithName User="User"/>
    </SettingsSection>

    <SettingsSection Title="@Localizer["Rättigheter"]" LoadDataAsync="LoadUserDataAsync">
        <MudOverlay DarkBackground="true" Visible="IsLoading" Absolute="true">
            <MudProgressCircular Size="Size.Large" Color="Color.Primary" Indeterminate="true" />
        </MudOverlay>
        <AccessClaimValuePicker PickedAccessClaimValues="UserAccess?.AccessClaimValues ?? []" PickChanged="UserAccessCheckBoxClick" />
    </SettingsSection>

    <SettingsSection Title="@Localizer["Roller"]">
        <RoleList Roles="PickedRoles" />
    </SettingsSection>
</SettingsPageBase>

@inject GetUserFunctionalAccessHandler GetUserAccess
@inject GrantUserFunctionalAccessHandler GrantUserAccess
@inject RevokeUserFunctionalAccessHandler RevokeUserAccess
@inject IRoleService RoleService
@inject IUserService UserService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

@code{
    [Parameter] public string? UserId { get; set; }
    User? User { get; set; }
    UserAccess? UserAccess { get; set; }
    List<Role> AllRoles { get; set; } = [];
    List<Role> PickedRoles { get; set; } = [];

    bool IsLoading { get; set; } = false;

    async Task LoadUserDataAsync()
    {
        SetIsLoading(true);
        if (UserId is not null && AuthService.OrganizationId is not null)
        {
            UserAccess = await GetUserAccess.HandleAsync(
                new GetUserFunctionalAccessQuery(UserId, AuthService.OrganizationId));
            User = await UserService.GetUserAsync(UserId);
            AllRoles = await RoleService.GetRolesAsync(AuthService.OrganizationId);
            var pickedRoles = await RoleService.GetRolesForUserAsync(UserId, AuthService.OrganizationId);
            PickedRoles = AllRoles.Where(r => pickedRoles.Any(pr => pr.Id == r.Id)).ToList();
        }
        SetIsLoading(false);
    }
    void SetIsLoading(bool isLoading)
    {
        IsLoading = isLoading;
        StateHasChanged();
    }
    Task UserAccessCheckBoxClick(PickChangedRecord<AccessClaimInfo> pickedRecord)
    {
        if (UserAccess is null) return Task.CompletedTask;
        if (pickedRecord.IsPicked && !UserAccess.AccessClaimValues.Contains(pickedRecord.Data.Value))
        {
            UserAccess.AccessClaimValues.Add(pickedRecord.Data.Value);
            return GrantUserAccess.HandleAsync(new GrantUserFunctionalAccessCommand(
                UserAccess.UserId,
                UserAccess.OrganizationId,
                pickedRecord.Data.Value));
        }
        else
        {
            UserAccess.AccessClaimValues.Remove(pickedRecord.Data.Value);
            return RevokeUserAccess.HandleAsync(new RevokeUserFunctionalAccessCommand(
                UserAccess.UserId,
                UserAccess.OrganizationId,
                pickedRecord.Data.Value));
        }
    }
}
