@page "/settings/access/users/{UserId}"
@inject IStringLocalizer<EditUserAccessPage> Localizer

<SettingsPageBase>

    <SettingsSection Title="@Localizer["Användare"]">
        <UserAvatarWithName Name="@User?.Name" AvatarBase64="@User?.AvatarBase64"/>
    </SettingsSection>

    <SettingsSection Title="@Localizer["Rättigheter"]" LoadDataAsync="LoadUserDataAsync">
        <MudOverlay DarkBackground="true" Visible="IsLoading" Absolute="true">
            <MudProgressCircular Size="Size.Large" Color="Color.Primary" Indeterminate="true" />
        </MudOverlay>
        <AccessClaimValuePicker PickedAccessClaimValues="PickedAccessClaimValues" PickChanged="UserAccessCheckBoxClick" />
    </SettingsSection>

    <SettingsSection Title="@Localizer["Roller"]">
        <RoleList Roles="PickedRoles" />
    </SettingsSection>
</SettingsPageBase>

@inject GetUserFunctionalAccessQueryHandler GetUserFunctionalAccess
@inject GrantUserFunctionalAccessCommandHandler GrantUserFunctionalAccess
@inject RevokeUserFunctionalAccessCommandHandler RevokeUserFunctionalAccess
@inject IAccessDirectory AccessDirectory
@inject ICurrentUserContext CurrentUserContext
@inject NavigationManager NavigationManager

@code{
    [Parameter] public string? UserId { get; set; }
    AccessDirectoryUser? User { get; set; }
    IReadOnlyList<string> PickedAccessClaimValues { get; set; } = [];
    OrganizationId OrganizationId { get; set; }
    List<AccessDirectoryRole> AllRoles { get; set; } = [];
    List<AccessDirectoryRole> PickedRoles { get; set; } = [];

    UserId? strongUserId => UserId is not null ? new UserId(UserId) : null;
    bool IsLoading { get; set; } = false;

    async Task LoadUserDataAsync()
    {
        SetIsLoading(true);

        var currentUser = await CurrentUserContext.GetCurrentUserAsync();
        if (strongUserId is not null && currentUser is not null)
        {
            OrganizationId = currentUser.OrganizationId;
            var accessResult = await GetUserFunctionalAccess.HandleAsync(
                new GetUserFunctionalAccessQuery(strongUserId.Value, currentUser.OrganizationId),
                CancellationToken.None);
            if (accessResult is UserFunctionalAccessLoaded loadedAccess)
            {
                PickedAccessClaimValues = loadedAccess.AccessClaimValues;
            }

            User = await AccessDirectory.GetUserAsync(strongUserId.Value);
            AllRoles = await AccessDirectory.GetRolesAsync(currentUser.OrganizationId);
            var pickedRoles = await AccessDirectory.GetRolesForUserAsync(strongUserId.Value, currentUser.OrganizationId);
            PickedRoles = AllRoles.Where(r => pickedRoles.Any(pr => pr.Id == r.Id)).ToList();
        }
        SetIsLoading(false);
    }
    void SetIsLoading(bool isLoading)
    {
        IsLoading = isLoading;
        StateHasChanged();
    }
    Task UserAccessCheckBoxClick(PickChangedRecord<AccessClaimDefinition> pickedRecord)
    {
        if (strongUserId is null || OrganizationId.IsEmpty) return Task.CompletedTask;
        if (pickedRecord.IsPicked && !PickedAccessClaimValues.Contains(pickedRecord.Data.Value))
        {
            return GrantAccessClaimAsync(pickedRecord.Data.Value);
        }

        if (!pickedRecord.IsPicked && PickedAccessClaimValues.Contains(pickedRecord.Data.Value))
        {
            return RevokeAccessClaimAsync(pickedRecord.Data.Value);
        }

        return Task.CompletedTask;
    }

    async Task GrantAccessClaimAsync(string accessClaimValue)
    {
        var result = await GrantUserFunctionalAccess.HandleAsync(
            new GrantUserFunctionalAccessCommand(strongUserId!.Value, OrganizationId, accessClaimValue),
            CancellationToken.None);
        if (result is UserFunctionalAccessGranted granted)
        {
            PickedAccessClaimValues = granted.AccessClaimValues;
        }
    }

    async Task RevokeAccessClaimAsync(string accessClaimValue)
    {
        var result = await RevokeUserFunctionalAccess.HandleAsync(
            new RevokeUserFunctionalAccessCommand(strongUserId!.Value, OrganizationId, accessClaimValue),
            CancellationToken.None);
        if (result is UserFunctionalAccessRevoked revoked)
        {
            PickedAccessClaimValues = revoked.AccessClaimValues;
        }
    }
}
