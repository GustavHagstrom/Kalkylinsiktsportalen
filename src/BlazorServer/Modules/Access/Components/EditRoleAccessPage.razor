@page "/settings/access/roles/{RoleId}"
@inject IStringLocalizer<EditRoleAccessPage> Localizer

<SettingsPageBase IsLoading="IsLoading">
    <SettingsSection Title="@Localizer["Roll"]">
        <MudText Typo="Typo.subtitle2">@Role?.Name</MudText>
    </SettingsSection>

    <SettingsSection Title="@Localizer["Rättigheter"]" LoadDataAsync="LoadDataAsync">
        <AccessClaimValuePicker PickedAccessClaimValues="RoleAccessGrant?.AccessClaimValues ?? []" PickChanged="RoleAccessCheckBoxClick" />
    </SettingsSection>
    
    <SettingsSection Title="@Localizer["Användare"]">
        <UserList Users="PickedUsers"/>
    </SettingsSection>

</SettingsPageBase>


@inject FunctionalAccessGrantHandler FunctionalAccessGrants
@inject IAccessDirectory AccessDirectory
@inject IDialogService DialogService
@inject ICurrentUserSession CurrentUserSession
@inject NavigationManager NavigationManager

@code{
    [Parameter] public string? RoleId { get; set; }

    bool IsLoading { get; set; } = false;

    AccessDirectoryRole? Role { get; set; }
    FunctionalAccessGrant? RoleAccessGrant { get; set; }

    List<AccessDirectoryUser> PickedUsers { get; set; } = new();

    // string Title => Role is null ? "Roll: " : $"{Localizer["Roll:"]} {Role.Name}";
    void EditUser(AccessDirectoryUser user)
    {
        NavigationManager.NavigateTo($"{Constants.Routes.UserAccessEdit}/{user.Id}");
    }


    async Task LoadDataAsync()
    {
        SetIsLoading(true);
        await CurrentUserSession.RefreshAsync();

        if (RoleId is not null && CurrentUserSession.OrganizationId is not null)
        {
            RoleAccessGrant = await FunctionalAccessGrants.HandleAsync(
                new GetRoleFunctionalAccessQuery(RoleId, CurrentUserSession.OrganizationId));
            Role = await AccessDirectory.GetRoleAsync(RoleId);
            PickedUsers = await AccessDirectory.GetUsersInRoleAsync(RoleId, CurrentUserSession.OrganizationId);
        }
        SetIsLoading(false);
    }
    void SetIsLoading(bool isLoading)
    {
        IsLoading = isLoading;
        StateHasChanged();
    }
    Task RoleAccessCheckBoxClick(PickChangedRecord<AccessClaimContribution> checkedRecord)
    {
        if (RoleAccessGrant is null) return Task.CompletedTask;
        if (checkedRecord.IsPicked && !RoleAccessGrant.AccessClaimValues.Contains(checkedRecord.Data.Value))
        {
            RoleAccessGrant = new FunctionalAccessGrant(
                RoleAccessGrant.Target,
                RoleAccessGrant.OrganizationId,
                RoleAccessGrant.AccessClaimValues.Append(checkedRecord.Data.Value));
            return FunctionalAccessGrants.HandleAsync(new GrantRoleFunctionalAccessCommand(
                RoleAccessGrant.Target.Id,
                RoleAccessGrant.OrganizationId,
                checkedRecord.Data.Value));
        }
        else
        {
            RoleAccessGrant = new FunctionalAccessGrant(
                RoleAccessGrant.Target,
                RoleAccessGrant.OrganizationId,
                RoleAccessGrant.AccessClaimValues.Where(value => value != checkedRecord.Data.Value));
            return FunctionalAccessGrants.HandleAsync(new RevokeRoleFunctionalAccessCommand(
                RoleAccessGrant.Target.Id,
                RoleAccessGrant.OrganizationId,
                checkedRecord.Data.Value));
        }
        
    }
}
