@page "/settings/access/roles/{RoleId}"
@inject IStringLocalizer<EditRoleAccessPage> Localizer

<SettingsPageBase IsLoading="IsLoading">
    <SettingsSection Title="@Localizer["Roll"]">
        <MudText Typo="Typo.subtitle2">@Role?.Name</MudText>
    </SettingsSection>

    <SettingsSection Title="@Localizer["Rättigheter"]" LoadDataAsync="LoadDataAsync">
        <AccessClaimValuePicker PickedAccessClaimValues="RoleAccess?.AccessClaimValues ?? []" PickChanged="RoleAccessCheckBoxClick" />
    </SettingsSection>
    
    <SettingsSection Title="@Localizer["Användare"]">
        <UserList Users="PickedUsers"/>
    </SettingsSection>

</SettingsPageBase>


@inject GetRoleFunctionalAccessHandler GetRoleAccess
@inject GrantRoleFunctionalAccessHandler GrantRoleAccess
@inject RevokeRoleFunctionalAccessHandler RevokeRoleAccess
@inject IUserService UserService
@inject IRoleService RoleService
@inject IDialogService DialogService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

@code{
    [Parameter] public string? RoleId { get; set; }

    bool IsLoading { get; set; } = false;

    Role? Role { get; set; }
    RoleAccess? RoleAccess { get; set; }

    List<User> PickedUsers { get; set; } = new();

    // string Title => Role is null ? "Roll: " : $"{Localizer["Roll:"]} {Role.Name}";
    void EditUser(User user)
    {
        NavigationManager.NavigateTo($"{Constants.Routes.UserAccessEdit}/{user.Id}");
    }


    async Task LoadDataAsync()
    {
        SetIsLoading(true);
        if (RoleId is not null && AuthService.OrganizationId is not null)
        {
            RoleAccess = await GetRoleAccess.HandleAsync(
                new GetRoleFunctionalAccessQuery(RoleId, AuthService.OrganizationId));
            Role = await RoleService.GetRoleAsync(RoleId);
            PickedUsers = await RoleService.GetUsersInRoleAsync(RoleId, AuthService.OrganizationId);
        }
        SetIsLoading(false);
    }
    void SetIsLoading(bool isLoading)
    {
        IsLoading = isLoading;
        StateHasChanged();
    }
    Task RoleAccessCheckBoxClick(PickChangedRecord<AccessClaimInfo> checkedRecord)
    {
        if (RoleAccess is null) return Task.CompletedTask;
        if (checkedRecord.IsPicked && !RoleAccess.AccessClaimValues.Contains(checkedRecord.Data.Value))
        {
            RoleAccess.AccessClaimValues.Add(checkedRecord.Data.Value);
            return GrantRoleAccess.HandleAsync(new GrantRoleFunctionalAccessCommand(
                RoleAccess.RoleId,
                RoleAccess.OrgId,
                checkedRecord.Data.Value));
        }
        else
        {
            RoleAccess.AccessClaimValues.Remove(checkedRecord.Data.Value);
            return RevokeRoleAccess.HandleAsync(new RevokeRoleFunctionalAccessCommand(
                RoleAccess.RoleId,
                RoleAccess.OrgId,
                checkedRecord.Data.Value));
        }
        
    }
}
