@page "/settings/access/roles/{RoleId}"
@inject IStringLocalizer<EditRoleAccessPage> Localizer

<SettingsPageBase IsLoading="IsLoading">
    <SettingsSection Title="@Localizer["Roll"]">
        <MudText Typo="Typo.subtitle2">@Role?.Name</MudText>
    </SettingsSection>

    <SettingsSection Title="@Localizer["Rättigheter"]" LoadDataAsync="LoadDataAsync">
        <AccessClaimValuePicker PickedAccessClaimValues="PickedAccessClaimValues" PickChanged="RoleAccessCheckBoxClick" />
    </SettingsSection>
    
    <SettingsSection Title="@Localizer["Användare"]">
        <UserList Users="PickedUsers"/>
    </SettingsSection>

</SettingsPageBase>


@inject GetRoleFunctionalAccessQueryHandler GetRoleFunctionalAccess
@inject GrantRoleFunctionalAccessCommandHandler GrantRoleFunctionalAccess
@inject RevokeRoleFunctionalAccessCommandHandler RevokeRoleFunctionalAccess
@inject IAccessDirectory AccessDirectory
@inject IDialogService DialogService
@inject ICurrentUserContext CurrentUserSession
@inject NavigationManager NavigationManager

@code{
    [Parameter] public string? RoleId { get; set; }

    bool IsLoading { get; set; } = false;

    AccessDirectoryRole? Role { get; set; }
    IReadOnlyList<string> PickedAccessClaimValues { get; set; } = [];
    OrganizationId OrganizationId { get; set; }

    List<AccessDirectoryUser> PickedUsers { get; set; } = new();

    // string Title => Role is null ? "Roll: " : $"{Localizer["Roll:"]} {Role.Name}";
    void EditUser(AccessDirectoryUser user)
    {
        NavigationManager.NavigateTo($"{Constants.Routes.UserAccessEdit}/{user.Id}");
    }


    async Task LoadDataAsync()
    {
        SetIsLoading(true);

        var currentUser = await CurrentUserSession.GetCurrentUserAsync();
        if (RoleId is not null && currentUser?.OrganizationId.IsEmpty == false)
        {
            OrganizationId = currentUser.OrganizationId;
            var accessResult = await GetRoleFunctionalAccess.HandleAsync(
                new GetRoleFunctionalAccessQuery(RoleId, currentUser.OrganizationId),
                CancellationToken.None);
            if (accessResult is RoleFunctionalAccessLoaded loadedAccess)
            {
                PickedAccessClaimValues = loadedAccess.AccessClaimValues;
            }

            Role = await AccessDirectory.GetRoleAsync(RoleId);
            PickedUsers = await AccessDirectory.GetUsersInRoleAsync(RoleId, currentUser.OrganizationId);
        }
        SetIsLoading(false);
    }
    void SetIsLoading(bool isLoading)
    {
        IsLoading = isLoading;
        StateHasChanged();
    }
    Task RoleAccessCheckBoxClick(PickChangedRecord<AccessClaimDefinition> checkedRecord)
    {
        if (RoleId is null || OrganizationId.IsEmpty) return Task.CompletedTask;
        if (checkedRecord.IsPicked && !PickedAccessClaimValues.Contains(checkedRecord.Data.Value))
        {
            return GrantAccessClaimAsync(checkedRecord.Data.Value);
        }

        if (!checkedRecord.IsPicked && PickedAccessClaimValues.Contains(checkedRecord.Data.Value))
        {
            return RevokeAccessClaimAsync(checkedRecord.Data.Value);
        }

        return Task.CompletedTask;
    }

    async Task GrantAccessClaimAsync(string accessClaimValue)
    {
        var result = await GrantRoleFunctionalAccess.HandleAsync(
            new GrantRoleFunctionalAccessCommand(RoleId!, OrganizationId, accessClaimValue),
            CancellationToken.None);
        if (result is RoleFunctionalAccessGranted granted)
        {
            PickedAccessClaimValues = granted.AccessClaimValues;
        }
    }

    async Task RevokeAccessClaimAsync(string accessClaimValue)
    {
        var result = await RevokeRoleFunctionalAccess.HandleAsync(
            new RevokeRoleFunctionalAccessCommand(RoleId!, OrganizationId, accessClaimValue),
            CancellationToken.None);
        if (result is RoleFunctionalAccessRevoked revoked)
        {
            PickedAccessClaimValues = revoked.AccessClaimValues;
        }
    }
}
