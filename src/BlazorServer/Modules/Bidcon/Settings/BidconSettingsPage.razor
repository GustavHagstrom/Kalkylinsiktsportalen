@page "/settings/bidcon"
@attribute [Authorize(Policy = "ApiPolicy")]
@using BlazorServer.Kernel.Validation
@inject IStringLocalizer<BidconSettingsPage> Localizer

<SettingsPageBase Title="@Localizer["Bidcon API"]">
    <SettingsSection LoadDataAsync="LoadDataAsync">
        <KipTextField TValue="string" Label="@Localizer["Sparad nyckel"]" Value="@currentKey" />
        <KipTextField TValue="string" Label="@Localizer["Sparad hemlighet"]" Value="@currentSecret" />
        <KipTextField TValue="string" Label="@Localizer["Ny nyckel"]" Value="@newKey" ValueChanged="@UpdateKeyAsync" />
        <KipTextField TValue="string" Label="@Localizer["Ny hemlighet"]" Value="@newSecret" ValueChanged="@UpdateSecretAsync" />
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@Localizer["Spara"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RemoveAsync" Disabled="@(!isConfigured)">@Localizer["Ta bort"]</MudButton>
        </MudStack>
        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <MudText Color="@statusColor">@statusMessage</MudText>
        }
    </SettingsSection>
</SettingsPageBase>

@inject Features.GetBidconCredentials.GetBidconCredentialsQueryHandler GetCredentialsHandler
@inject Features.UpsertBidconCredentials.UpsertBidconCredentialsCommandHandler UpsertCredentialsHandler
@inject Features.RemoveBidconCredentials.RemoveBidconCredentialsCommandHandler RemoveCredentialsHandler
@inject ICurrentUserContext CurrentUserContext

@code {
    private string currentKey = string.Empty;
    private string currentSecret = string.Empty;
    private string newKey = string.Empty;
    private string newSecret = string.Empty;
    private string statusMessage = string.Empty;
    private Color statusColor = Color.Default;
    private bool isConfigured;

    private Task UpdateKeyAsync(string value)
    {
        newKey = value;
        return Task.CompletedTask;
    }

    private Task UpdateSecretAsync(string value)
    {
        newSecret = value;
        return Task.CompletedTask;
    }

    private async Task LoadDataAsync()
    {
        if (CurrentUserContext.CurrentUser?.OrganizationId is null)
        {
            return;
        }

        var result = await GetCredentialsHandler.HandleAsync(
            new Features.GetBidconCredentials.GetBidconCredentialsQuery(
                CurrentUserContext.CurrentUser.OrganizationId),
            CancellationToken.None);

        if (result is Features.GetBidconCredentials.InvalidGetBidconCredentialsRequest invalidRequest)
        {
            ShowValidationErrors(invalidRequest.ValidationErrors);
            return;
        }

        if (result is Features.GetBidconCredentials.BidconCredentialsFound found)
        {
            currentKey = found.ApiKey;
            currentSecret = found.ApiSecret;
            isConfigured = true;
            return;
        }

        if (result is Features.GetBidconCredentials.BidconCredentialsNotConfigured notConfigured)
        {
            currentKey = notConfigured.ApiKey;
            currentSecret = notConfigured.ApiSecret;
            isConfigured = false;
        }
    }

    private async Task SaveAsync()
    {
        if (CurrentUserContext.CurrentUser?.OrganizationId is null)
        {
            return;
        }

        var result = await UpsertCredentialsHandler.HandleAsync(
            new Features.UpsertBidconCredentials.UpsertBidconCredentialsCommand(
                CurrentUserContext.CurrentUser.OrganizationId,
                CurrentUserContext.CurrentUser.UserId,
                newKey,
                newSecret),
            CancellationToken.None);

        if (result is Features.UpsertBidconCredentials.InvalidUpsertBidconCredentialsRequest invalidRequest)
        {
            ShowValidationErrors(invalidRequest.ValidationErrors);
            return;
        }

        if (result is Features.UpsertBidconCredentials.BidconCredentialsVerificationFailed verificationFailed)
        {
            statusColor = Color.Error;
            statusMessage = verificationFailed.Message;
            return;
        }

        newKey = string.Empty;
        newSecret = string.Empty;
        statusColor = Color.Success;
        statusMessage = Localizer["Sparat."];
        await LoadDataAsync();
    }

    private async Task RemoveAsync()
    {
        if (CurrentUserContext.CurrentUser?.OrganizationId is null)
        {
            return;
        }

        var result = await RemoveCredentialsHandler.HandleAsync(
            new Features.RemoveBidconCredentials.RemoveBidconCredentialsCommand(
                CurrentUserContext.CurrentUser.OrganizationId,
                CurrentUserContext.CurrentUser.UserId),
            CancellationToken.None);

        if (result is Features.RemoveBidconCredentials.InvalidRemoveBidconCredentialsRequest invalidRequest)
        {
            ShowValidationErrors(invalidRequest.ValidationErrors);
            return;
        }

        currentKey = string.Empty;
        currentSecret = string.Empty;
        newKey = string.Empty;
        newSecret = string.Empty;
        isConfigured = false;
        statusColor = Color.Success;
        statusMessage = Localizer["Borttaget."];
    }

    private void ShowValidationErrors(IReadOnlyList<ValidationError> validationErrors)
    {
        statusColor = Color.Error;
        statusMessage = string.Join(" ", validationErrors.Select(error => error.Message));
    }
}
