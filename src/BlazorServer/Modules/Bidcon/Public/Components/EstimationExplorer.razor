@using BlazorServer.Modules.Bidcon.Components
@using BlazorServer.Modules.Bidcon.Features.GetEstimationList
@using BlazorServer.Modules.Bidcon.Public.Contracts
@inject IStringLocalizer<EstimationExplorer> Localizer

<MudOverlay Visible="IsLoading" DarkBackground="true" LockScroll="true">
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
</MudOverlay>

<ToolbarPage>
    <LeftToolbarContent>

    </LeftToolbarContent>
    <CenterToolbarContent>
        <MudStack Spacing="2" Row="true">
            <MudIconButton Size="Size.Medium" Color="Color.Primary" OnClick="LoadData" Icon="@Icons.Material.Sharp.Refresh" Class="pa-1" />
            <NavButton IsActive="ActiveTab == 1" OnClick="@(() => ActiveTab = 1)">@Localizer["Sök"]</NavButton>
            <NavButton IsActive="ActiveTab == 2" OnClick="@(() => ActiveTab = 2)">@($"{Localizer["Valda"]} ({EstimationListState.SelectedEstimations.Count})")</NavButton>
        </MudStack>
    </CenterToolbarContent>
    <ChildContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4 full-height">
            <MudPaper Class="full-height">
                @if (ActiveTab == 1)
                {
                    <EstimationList Estimations="@EstimationListState.Estimations" Height="100%" SelectionChanged="UpdateSelectedEstimations" />
                }
                else if (ActiveTab == 2)
                {
                    <EstimationList Estimations="@EstimationListState.SelectedEstimations" Height="100%" SelectionChanged="UpdateSelectedEstimations" />
                }
                else
                {
                    <MudText>@Localizer["Välj en flik"]</MudText>
                }
            </MudPaper>
        </MudContainer>
    </ChildContent>
</ToolbarPage>

@inject GetEstimationListQueryHandler GetEstimationListHandler
@inject ICurrentUserSession CurrentUserSession
@inject EstimationListState EstimationListState

@code {
    private int ActiveTab { get; set; } = 1;
    private bool IsLoading { get; set; }

    protected override Task OnInitializedAsync()
    {
        if (EstimationListState.HasLoaded)
        {
            return Task.CompletedTask;
        }

        return LoadData();
    }

    private async Task LoadData()
    {
        SetIsLoading(true);

        try
        {
            await CurrentUserSession.RefreshAsync();

            if (CurrentUserSession.CurrentUser?.Email is null || CurrentUserSession.OrganizationId is null)
            {
                return;
            }

            var result = await GetEstimationListHandler.HandleAsync(
                new GetEstimationListQuery(
                    new OrganizationId(CurrentUserSession.OrganizationId),
                    CurrentUserSession.CurrentUser.Email),
                CancellationToken.None);

            if (result is not EstimationListLoaded loaded)
            {
                return;
            }

            EstimationListState.Estimations = loaded.Estimations
                .Select(DtoToModel)
                .OrderBy(x => x.Name)
                .ToList();
            EstimationListState.HasLoaded = true;
        }
        finally
        {
            SetIsLoading(false);
        }
    }

    private void SetIsLoading(bool isLoading)
    {
        IsLoading = isLoading;
        StateHasChanged();
    }

    private static EstimationInfo DtoToModel(GetEstimationListItem dto)
    {
        var name = string.IsNullOrWhiteSpace(dto.Description)
            ? dto.Name
            : $"{dto.Name} - {dto.Description}";

        return new EstimationInfo(name, dto.Id, false);
    }

    private void UpdateSelectedEstimations()
    {
        EstimationListState.SelectedEstimations = EstimationListState.Estimations
            .Where(x => x.IsSelected)
            .ToList();
        StateHasChanged();
    }
}
