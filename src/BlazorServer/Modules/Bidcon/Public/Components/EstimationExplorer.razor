@inject IStringLocalizer<EstimationExplorer> Localizer

<MudOverlay Visible="IsLoading" DarkBackground="true" LockScroll="true">
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
</MudOverlay>

<ToolbarPage>
    <LeftToolbarContent>

    </LeftToolbarContent>
    <CenterToolbarContent>
        <MudStack Spacing="2" Row="true">
            <MudIconButton Size="Size.Medium" Color="Color.Primary" OnClick="RefreshAsync" Icon="@Icons.Material.Sharp.Refresh" Class="pa-1" />
            <NavButton IsActive="ActiveTab == 1" OnClick="@(() => ActiveTab = 1)">@Localizer["Sök"]</NavButton>
            <NavButton IsActive="ActiveTab == 2" OnClick="@(() => ActiveTab = 2)">@($"{Localizer["Valda"]} ({SelectedEstimations.Count})")</NavButton>
        </MudStack>
    </CenterToolbarContent>
    <ChildContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4 full-height">
            <MudPaper Class="full-height">
                @if (ActiveTab == 1)
                {
                    @RenderEstimationList(Estimations)
                }
                else if (ActiveTab == 2)
                {
                    @RenderEstimationList(SelectedEstimations)
                }
                else
                {
                    <MudText>@Localizer["Välj en flik"]</MudText>
                }
            </MudPaper>
        </MudContainer>
    </ChildContent>
</ToolbarPage>

@code {
    [Parameter] public IReadOnlyList<EstimationExplorerItem> Estimations { get; set; } = [];
    [Parameter] public IReadOnlySet<string> SelectedBidconIds { get; set; } = new HashSet<string>(StringComparer.Ordinal);
    [Parameter] public EventCallback<IReadOnlySet<string>> SelectedBidconIdsChanged { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private int ActiveTab { get; set; } = 1;
    private string Filter { get; set; } = string.Empty;

    private IReadOnlyList<EstimationExplorerItem> SelectedEstimations
        => Estimations
            .Where(estimation => SelectedBidconIds.Contains(estimation.BidconId))
            .ToList();

    private RenderFragment RenderEstimationList(IEnumerable<EstimationExplorerItem> estimations) => @<div style="height: 100%">
        <div>
            <div class="d-flex" style="padding: 2px 2px 0px 2px">
                <MudCheckBox T="bool" Value="@FilteredEstimations(estimations).All(IsSelected)" ValueChanged="value => ToggleSelectedOnAllFiltered(estimations, value)" Dense="true" />
                <input placeholder="@Localizer["Sök"]" class="pa-2 flex-grow-1" style="outline: none; background-color: var(--mud-palette-background); color: var(--mud-palette-text-primary)" @bind="Filter" @bind:event="oninput" />
            </div>
            <MudDivider Light="true" />
        </div>
        <div style="overflow-y: scroll; position: relative; height: calc(100% - 37px)">
            <table class="striped" style="width: 100%;">
                <tbody>
                    <Virtualize Items="@FilteredEstimations(estimations)">
                        <tr class="d-flex">
                            <td class="d-flex flex-grow-1">
                                <MudCheckBox T="bool" Value="@IsSelected(context)" ValueChanged="value => SetSelectedAsync(context, value)" Dense="true" />
                                <MudIcon Icon="@Icons.Material.Sharp.Article" Style="color: var(--mud-palette-warning-lighten)" Class="align-self-center ml-0" />
                                <MudText Class="align-self-center ml-2">@context.Name</MudText>
                            </td>
                        </tr>
                    </Virtualize>
                </tbody>
            </table>
        </div>
    </div>;

    private List<EstimationExplorerItem> FilteredEstimations(IEnumerable<EstimationExplorerItem> estimations)
    {
        var words = Filter.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return estimations
            .Where(estimation => words.All(word => estimation.Name.Contains(word, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    private bool IsSelected(EstimationExplorerItem estimation)
        => SelectedBidconIds.Contains(estimation.BidconId);

    private Task RefreshAsync()
        => OnRefresh.InvokeAsync();

    private Task SetSelectedAsync(EstimationExplorerItem estimation, bool value)
    {
        var selectedBidconIds = SelectedBidconIds.ToHashSet(StringComparer.Ordinal);
        if (value)
        {
            selectedBidconIds.Add(estimation.BidconId);
        }
        else
        {
            selectedBidconIds.Remove(estimation.BidconId);
        }

        return SelectedBidconIdsChanged.InvokeAsync(selectedBidconIds);
    }

    private async Task ToggleSelectedOnAllFiltered(IEnumerable<EstimationExplorerItem> estimations, bool value)
    {
        var selectedBidconIds = SelectedBidconIds.ToHashSet(StringComparer.Ordinal);
        foreach (var estimation in FilteredEstimations(estimations))
        {
            if (value)
            {
                selectedBidconIds.Add(estimation.BidconId);
            }
            else
            {
                selectedBidconIds.Remove(estimation.BidconId);
            }
        }

        await SelectedBidconIdsChanged.InvokeAsync(selectedBidconIds);
    }
}
