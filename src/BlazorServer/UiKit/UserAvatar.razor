@inherits StyleComponent

<style>
    .avatar-style {
        background-color: var(--mud-palette-action-default-hover);
        box-shadow: 0px 3px 5px -1px rgba(0,0,0,.2), 0px 6px 10px 0px rgba(0,0,0,.14), 0px 1px 18px 0px rgba(0,0,0,.12);
    }

    .avatar-style.clickable {
            cursor: pointer;
        }

    .avatar-style.clickable::after {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(255, 200, 0, 0);
        pointer-events: none;
        transition: background 0.25s ease;
    }

    .avatar-style.clickable:hover::after {
            background: var(--mud-palette-action-default-hover);
    }
</style>

@if (!string.IsNullOrWhiteSpace(Name))
{
    <MudAvatar Size="Size" Class="@ClassNames" Style="@Style" @onclick="@OnAvatarClick">
        @if (AvatarBase64 != null)
        {
            <MudImage Src="@($"data:image/png;base64, {AvatarBase64}")" Alt="User photo" />
        }
        else
        {
            <div class="pa-0">
                @Name.First()
            </div>
        }
    </MudAvatar>
}
else
{
    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" Class="@ClassNames" Style="@Style" @onclick="@OnClick" />
}

@code{
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? AvatarBase64 { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public bool Clickable { get; set; } = true;

    string ClassNames => $"{Class} avatar-style {(Clickable ? "clickable" : "")}";

    Task OnAvatarClick(MouseEventArgs args)
    {
        return Clickable ? OnClick.InvokeAsync(args) : Task.CompletedTask;
    }
}
